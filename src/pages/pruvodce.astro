---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const lessons = [
  {
    n: '01',
    title: 'Začněte technologií a použitím',
    copy: 'Nejdřív zjistěte rozdíl mezi FDM, resinem a SLS. Potom si odpovězte na sedm otázek před objednávkou první tiskárny.',
    links: [
      { href: '/clanky/co-je-3d-tisk-fdm-resin-sls/', label: 'Co je 3D tisk: FDM, resin, SLS' },
      { href: '/clanky/jak-vybrat-prvni-3d-tiskarnu-7-otazek/', label: 'Jak vybrat první tiskárnu' },
    ],
  },
  {
    n: '02',
    title: 'První vrstva',
    copy: 'Z-offset, čistá podložka a diagnostika první čáry. Tady se rozhoduje velká část spolehlivosti.',
    links: [
      { href: '/rady-a-tipy/z-offset/', label: 'Z-offset bez tápání' },
      { href: '/rady-a-tipy/prvni-vrstva-nedrzi/', label: 'Když první vrstva nedrží' },
    ],
  },
  {
    n: '03',
    title: 'Slicer a průtok',
    copy: 'Začněte oficiálním profilem stroje. Pokročilé ladění přidávejte až ve chvíli, kdy umíte říct proč.',
    links: [
      { href: '/clanky/slicer-pro-zacatecniky-prusaslicer-bambu-studio-orcaslicer/', label: 'PrusaSlicer, Bambu Studio, nebo OrcaSlicer?' },
      { href: '/rady-a-tipy/kalibrace-flow/', label: 'Kalibrace flow' },
    ],
  },
  {
    n: '04',
    title: 'Materiály',
    copy: 'PLA, PETG, ASA a TPU podle použití, teploty, vlhkosti a nároků na prostředí.',
    links: [
      { href: '/clanky/pla-petg-asa-tpu-ktery-material-kdy/', label: 'Který materiál kdy' },
      { href: '/materialy/', label: 'Materiálová reference a zdroje' },
    ],
  },
  {
    n: '05',
    title: 'Výběr ekosystému',
    copy: 'Když už víte, co budete tisknout, dává smysl řešit servis, software, otevřenost a multimateriál.',
    links: [
      { href: '/clanky/prusa-vs-bambu-lab-srovnani/', label: 'Prusa vs. Bambu Lab' },
      { href: '/nakupni-radci/', label: 'Nákupní rádci' },
    ],
  },
  {
    n: '06',
    title: 'Když se tisk nebo stroj pokazí',
    copy: 'Symptom → pravděpodobná příčina → jeden diagnostický krok → ověření výsledku. Chybové kódy řešte podle přesného čísla.',
    links: [
      { href: '/problemy/', label: 'Tisková poradna podle symptomu' },
      { href: '/rady-a-tipy/bambu-lab-hms-chybove-kody-cesky/', label: 'Bambu HMS kódy' },
      { href: '/rady-a-tipy/prusa-chybove-kody-cesky/', label: 'Prusa chybové kódy' },
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Kompletní průvodce 3D tiskem',
  url: new URL('/pruvodce/', site.url).href,
  inLanguage: 'cs',
};
---

<BaseLayout title="Kompletní průvodce 3D tiskem" description="Šest navazujících lekcí od výběru první technologie po diagnostiku vad a chybových kódů. Praktický průvodce První Vrstvy pro začátečníky." jsonLd={jsonLd}>
  <main id="obsah" class="page section-page guide-hub">
    <p class="kicker">PRŮVODCE 01–06</p>
    <h1 class="page-title">Od první tiskárny k vlastnímu workflow.</h1>
    <p class="lede">Nejde o encyklopedii. Každá lekce má vyřešit jednu část cesty a poslat vás na další konkrétní krok.</p>

    <aside class="guide-rule">
      <strong>Jak průvodce používat</strong>
      <p>Jste úplně na začátku? Jděte od 01. Řešíte konkrétní problém? Skočte rovnou do lekce nebo do tiskové poradny. Každý text má dát odpověď dřív než teorii.</p>
    </aside>

    <ol class="lesson-list">
      {lessons.map((lesson) => (
        <li class="lesson-card">
          <span class="lesson-number">{lesson.n}</span>
          <div>
            <h2>{lesson.title}</h2>
            <p>{lesson.copy}</p>
            <div class="lesson-links">
              {lesson.links.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}
            </div>
          </div>
        </li>
      ))}
    </ol>

    <aside class="article-next">
      <div>
        <p>Máte konkrétní vadu?</p>
        <h2>Nečtěte všechno. Začněte symptomem.</h2>
        <span>Warping, stringing, vlhký filament, posun vrstev, první vrstva a další typické závady jsou v poradně seřazené podle toho, co skutečně vidíte.</span>
      </div>
      <a href="/problemy/">Tisková poradna <span aria-hidden="true">→</span></a>
    </aside>
  </main>
</BaseLayout>

<style>
  .guide-hub { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .guide-rule { margin: 2rem 0; border-left: 4px solid var(--color-accent); background: var(--color-card); padding: 1rem 1.2rem; }
  .guide-rule strong { font-size: 1rem; }
  .guide-rule p { max-width: 62rem; margin: .25rem 0 0; color: var(--color-muted); }
  .lesson-list { display: grid; gap: 0; margin: 2rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--color-line); }
  .lesson-card { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 1rem; border-bottom: 1px solid var(--color-line); padding: 1.35rem 0; }
  .lesson-number { color: var(--color-accent-ink); font-family: 'Iowan Old Style', 'Baskerville', serif; font-size: 2.3rem; line-height: 1; }
  .lesson-card h2 { margin: 0; font-family: 'Iowan Old Style', 'Baskerville', serif; font-size: clamp(1.5rem, 3vw, 2.35rem); letter-spacing: -.035em; }
  .lesson-card p { max-width: 50rem; margin: .4rem 0 .8rem; color: var(--color-muted); }
  .lesson-links { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
  .lesson-links a { color: var(--color-ink); font-size: .88rem; font-weight: 720; text-underline-offset: 3px; }
  .article-next { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: 3rem; border-radius: var(--radius-card); background: var(--color-night); padding: clamp(1.2rem, 3vw, 1.7rem); color: #f5f5f7; }
  .article-next > div { display: grid; gap: .25rem; }
  .article-next p { margin: 0; color: var(--color-accent); font-size: .7rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .article-next h2 { margin: 0; font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -.04em; }
  .article-next div > span { max-width: 48rem; color: rgba(245,245,247,.68); font-size: .92rem; }
  .article-next > a { display: inline-flex; flex: none; align-items: center; gap: .55rem; border-radius: 999px; background: var(--color-accent); padding: .7rem 1rem; color: #1a0d08; font-weight: 720; text-decoration: none; }
  @media (max-width: 680px) {
    .lesson-card { grid-template-columns: 3.4rem minmax(0, 1fr); }
    .lesson-number { font-size: 1.8rem; }
    .article-next { align-items: flex-start; flex-direction: column; }
  }
</style>
