---
import BaseLayout from '../layouts/BaseLayout.astro';
import RubrikaIndex from '../components/RubrikaIndex.astro';

const description = 'Tahle stránka na První vrstvě není. Zkuste rubriky, nebo se vraťte na úvod.';
---

<BaseLayout title="Stránka nenalezena" description={description} noindex={true}>
  <main id="obsah" class="page section-page">
    <p class="kicker">404</p>
    <h1 class="page-title">Tahle vrstva se nevytiskla.</h1>
    <p class="lede">
      Adresa neexistuje, nebo jsme text stáhli z tisku. Deska je pořád na místě — začněte znovu od
      úvodu, nebo zvolte rubriku.
    </p>
    <p class="hero-actions" style="margin-top: 1.5rem">
      <a class="btn btn-light" href="/" style="background: var(--color-ink); color: #fff">Zpět na úvod</a>
    </p>
    <RubrikaIndex />
  </main>
</BaseLayout>
