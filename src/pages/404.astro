---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, categoryOrder } from '../lib/categories';

const description = 'Tahle stránka na První vrstvě není. Zkuste rubriky, nebo se vraťte na úvod.';
---

<BaseLayout title="Stránka nenalezena" description={description} noindex={true}>
  <main id="obsah" class="mx-auto max-w-6xl px-5 py-16">
    <p class="kicker">404</p>
    <h1 class="mt-3 max-w-[14ch] font-serif text-[clamp(2.6rem,6vw,4.4rem)] leading-[0.98] font-semibold tracking-tight">
      Tahle vrstva se nevytiskla.
    </h1>
    <p class="mt-5 max-w-[48ch] text-xl text-ink-soft">
      Adresa neexistuje, nebo jsme text stáhli z tisku. Deska je pořád na místě — začněte znovu od
      úvodu, nebo zvolte rubriku.
    </p>
    <p class="mt-8">
      <a class="font-semibold text-copper-ink underline underline-offset-4" href="/">Zpět na úvod</a>
    </p>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        categoryOrder.map((id) => (
          <li>
            <a class="rubrika" href={categories[id].href}>
              <span class="rubrika-label">{categories[id].label}</span>
              <span class="rubrika-desc">{categories[id].description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
