---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExtrusionTrace from '../components/ExtrusionTrace.astro';
import SymptomIcon from '../components/SymptomIcon.astro';

const description =
  'Vizuální diagnostika nejčastějších problémů 3D tisku: první vrstva, warping, stringing, elephant foot, vlhký filament, under-extrusion, ucpaná tryska a layer shift.';

const problems = [
  {
    kind: 'first-layer',
    group: 'prvni-vrstva',
    title: 'První vrstva nedrží',
    symptom: 'Čára se odlepuje, trhá nebo se model po chvíli utrhne z podložky.',
    first: 'Čistota podložky → tvar čáry → Z-offset → rychlost → teplota.',
    tags: 'první vrstva adheze z-offset deska',
    href: '/rady-a-tipy/prvni-vrstva-nedrzi/',
  },
  {
    kind: 'warp',
    group: 'geometrie',
    title: 'Warping',
    symptom: 'Rohy nebo velká plocha se během tisku zvedají a díl se kroutí.',
    first: 'Teplotní prostředí → adheze → geometrie dílu → brim / komora.',
    tags: 'warping abs asa rohy komora',
    href: '/clanky/warping-u-abs-priciny-a-checklist/',
  },
  {
    kind: 'string',
    group: 'povrch',
    title: 'Stringing',
    symptom: 'Mezi dvěma částmi modelu zůstávají jemné nitky a pavučinky.',
    first: 'Suchý filament → teplota → travel → retrakce.',
    tags: 'stringing retrakce petg nitky vlhkost',
    href: '/rady-a-tipy/stringing-retrakce/',
  },
  {
    kind: 'foot',
    group: 'prvni-vrstva',
    title: 'Elephant foot',
    symptom: 'Spodní vrstvy jsou rozmáčknuté a přesahují půdorys modelu.',
    first: 'Z-offset → teplota podložky → kompenzace v sliceru.',
    tags: 'elephant foot sloni noha spodni vrstva',
    href: '/rady-a-tipy/elephant-foot/',
  },
  {
    kind: 'wet',
    group: 'material',
    title: 'Vlhký filament',
    symptom: 'U trysky to praská, povrch je nepravidelný a objevují se bublinky nebo struny.',
    first: 'Kontrolované sušení → stejný test → teprve potom profil.',
    tags: 'vlhky filament petg nylon tpu suseni bubliny',
    href: '/rady-a-tipy/vlhky-filament/',
  },
  {
    kind: 'flow',
    group: 'extruze',
    title: 'Under-extrusion',
    symptom: 'Ve stěnách jsou mezery, perimetry slábnou nebo extruder nestíhá dodávat materiál.',
    first: 'Cívka → vedení → extruder → tryska → rychlost / flow.',
    tags: 'under extrusion mezery slaby tok extruder flow',
    href: '/rady-a-tipy/under-extrusion/',
  },
  {
    kind: 'clog',
    group: 'extruze',
    title: 'Ucpaná tryska',
    symptom: 'Tok je nepravidelný, zeslabuje nebo extruder cvaká i při rozumném profilu.',
    first: 'Vyloučit odpor před hotendem → potvrdit tok → servis podle výrobce.',
    tags: 'ucpana tryska clog hotend cvakani slaby tok',
    href: '/rady-a-tipy/ucpana-tryska/',
  },
  {
    kind: 'shift',
    group: 'geometrie',
    title: 'Layer shift',
    symptom: 'Od určité vrstvy je celý zbytek modelu posunutý do strany.',
    first: 'Určit osu → kolize → volný pohyb → řemen / kladka → profil.',
    tags: 'layer shift posun vrstvy osa remen kolize',
    href: '/rady-a-tipy/layer-shift/',
  },
  {
    kind: 'first-layer',
    group: 'prvni-vrstva',
    title: 'Z-offset',
    symptom: 'První čára je kulatá a volná, nebo naopak tryska materiál rozhrnuje.',
    first: 'Dívat se na skutečnou stopu extruze, ne kopírovat cizí číslo.',
    tags: 'z offset vyska trysky prvni cara kalibrace',
    href: '/rady-a-tipy/z-offset/',
  },
  {
    kind: 'plate',
    group: 'prvni-vrstva',
    title: 'Podložka nedrží jako dřív',
    symptom: 'Stejný profil najednou drží jen v části plochy nebo se adheze postupně zhoršila.',
    first: 'Čištění vhodné pro konkrétní povrch → žádné mastné prsty → kontrola opotřebení.',
    tags: 'pei podlozka cisteni adheze deska',
    href: '/rady-a-tipy/bezpecne-cisteni-build-plate/',
  },
] as const;
---

<BaseLayout title="Tisková poradna" description={description}>
  <main id="obsah">
    <section class="problem-hero">
      <div class="page problem-hero-grid">
        <div>
          <p class="kicker">Tisková poradna · podle symptomu</p>
          <h1 class="page-title">Nezačínejte nastavením. Začněte tím, co opravdu vidíte.</h1>
          <p class="lede">
            Vyberte symptom. Každá cesta začíná nejpravděpodobnější a nejlevnější kontrolou — ne nákupem dílu nebo dvaceti změnami v sliceru.
          </p>
          <div class="hero-actions">
            <a class="btn btn-ink" href="#atlas">Najít problém</a>
            <a class="btn btn-line" href="/nastroje/">Otevřít nástroje</a>
          </div>
        </div>
        <div class="diagnostic-poster" aria-hidden="true">
          <div><SymptomIcon kind="warp" /><span>SYMPTOM</span></div>
          <i>→</i>
          <div><SymptomIcon kind="clog" /><span>PŘÍČINA</span></div>
          <i>→</i>
          <div><SymptomIcon kind="first-layer" /><span>OPRAVA</span></div>
        </div>
      </div>
      <ExtrusionTrace />
    </section>

    <section class="band" id="atlas" aria-labelledby="atlas-title">
      <div class="page">
        <div class="section-head problem-head">
          <div>
            <p class="kicker section-kicker-gap">Atlas problémů</p>
            <h2 id="atlas-title" class="display">Co přesně se pokazilo?</h2>
          </div>
          <label class="problem-search">
            <span class="sr-only">Hledat problém</span>
            <input data-problem-search type="search" placeholder="Např. rohy, struny, cvakání…" />
          </label>
        </div>

        <div class="problem-filters" role="group" aria-label="Filtrovat podle typu problému">
          <button type="button" data-problem-group="all" aria-pressed="true">Vše</button>
          <button type="button" data-problem-group="prvni-vrstva" aria-pressed="false">První vrstva</button>
          <button type="button" data-problem-group="povrch" aria-pressed="false">Povrch</button>
          <button type="button" data-problem-group="extruze" aria-pressed="false">Extruze</button>
          <button type="button" data-problem-group="geometrie" aria-pressed="false">Geometrie</button>
          <button type="button" data-problem-group="material" aria-pressed="false">Materiál</button>
        </div>

        <div class="problem-grid" data-problem-list>
          {problems.map((problem, index) => (
            <article
              class="problem-card"
              data-problem-card
              data-group={problem.group}
              data-search={`${problem.title} ${problem.symptom} ${problem.first} ${problem.tags}`}
            >
              <div class="problem-visual">
                <span class="problem-code">P{String(index + 1).padStart(2, '0')}</span>
                <SymptomIcon kind={problem.kind} />
              </div>
              <div class="problem-copy">
                <h3>{problem.title}</h3>
                <p>{problem.symptom}</p>
                <div class="problem-first">
                  <span>Začni tady</span>
                  <strong>{problem.first}</strong>
                </div>
                <a href={problem.href}>Otevřít diagnostiku <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
        <p class="problem-empty" data-problem-empty hidden>
          Tohle zatím v atlasu nemáme. Zkuste kratší výraz nebo pošlete symptom redakci přes kontakt v patičce.
        </p>
      </div>
    </section>

    <section class="problem-rule-band" aria-labelledby="rule-title">
      <div class="page rule-grid">
        <div>
          <p class="kicker kicker-light">Jedno pravidlo</p>
          <h2 id="rule-title" class="display display-light">Měňte jednu věc. Pak znovu tiskněte.</h2>
        </div>
        <ol>
          <li><span>01</span><strong>Popište symptom</strong><p>Co je na výtisku fyzicky jinak než má být?</p></li>
          <li><span>02</span><strong>Vyberte první test</strong><p>Nejlevnější a nejjednodušší věc, která příčinu potvrdí nebo vyloučí.</p></li>
          <li><span>03</span><strong>Změňte jednu proměnnou</strong><p>Jinak nebudete vědět, co skutečně pomohlo.</p></li>
          <li><span>04</span><strong>Ověřte stejným testem</strong><p>Stejný model, materiál a podmínky dávají smysluplné srovnání.</p></li>
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-problem-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-problem-card]')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-problem-group]')];
  const empty = document.querySelector<HTMLElement>('[data-problem-empty]');
  let activeGroup = 'all';

  const normalize = (value: string) => value.toLocaleLowerCase('cs').normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  const apply = () => {
    const query = normalize(search?.value.trim() ?? '');
    let visible = 0;
    for (const card of cards) {
      const groupOk = activeGroup === 'all' || card.dataset.group === activeGroup;
      const searchOk = !query || normalize(card.dataset.search ?? '').includes(query);
      const show = groupOk && searchOk;
      card.hidden = !show;
      if (show) visible += 1;
    }
    if (empty) empty.hidden = visible > 0;
  };

  search?.addEventListener('input', apply);
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      activeGroup = button.dataset.problemGroup ?? 'all';
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      apply();
    });
  });
</script>

<style>
  .problem-hero {
    position: relative;
    overflow: clip;
    border-bottom: 1px solid var(--color-line);
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  .problem-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, .95fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .problem-hero :global(.extrusion-trace) {
    position: absolute;
    right: -10rem;
    bottom: -6rem;
    width: min(58rem, 72vw);
    color: var(--color-accent);
    opacity: .1;
    pointer-events: none;
  }

  .diagnostic-poster {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: .7rem;
    border-block: 1px solid var(--color-line);
    padding-block: 1.2rem;
  }

  .diagnostic-poster > div { display: grid; gap: .3rem; justify-items: center; color: var(--color-ink); }
  .diagnostic-poster :global(.symptom-icon) { max-width: 7rem; }
  .diagnostic-poster span { color: var(--color-muted); font-size: .62rem; font-weight: 760; letter-spacing: .1em; }
  .diagnostic-poster > i { color: var(--color-accent); font-size: 1.6rem; font-style: normal; }

  .problem-head { align-items: end; }
  .problem-search input {
    width: min(20rem, 100%);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    padding: .75rem 1rem;
    color: var(--color-ink);
    box-shadow: var(--shadow-card);
  }

  .problem-filters {
    display: flex;
    gap: .45rem;
    margin-top: 1.4rem;
    overflow-x: auto;
    padding-bottom: .25rem;
    scrollbar-width: none;
  }
  .problem-filters::-webkit-scrollbar { display: none; }
  .problem-filters button {
    flex: none;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    padding: .48rem .8rem;
    color: var(--color-ink-soft);
    font-weight: 650;
    cursor: pointer;
  }
  .problem-filters button[aria-pressed='true'] { border-color: var(--color-accent); background: var(--color-accent); color: #1a0d08; }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .problem-card {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .problem-card[hidden] { display: none; }

  .problem-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 13rem;
    border-right: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-paper));
    padding: .8rem;
  }
  .problem-code { position: absolute; top: .6rem; left: .65rem; color: var(--color-accent-ink); font-size: .65rem; font-weight: 760; letter-spacing: .08em; }
  .problem-visual :global(.symptom-icon) { width: 100%; max-width: 7rem; }

  .problem-copy { display: flex; flex-direction: column; padding: 1rem 1.05rem; }
  .problem-copy h3 { margin: 0; font-size: 1.25rem; letter-spacing: -.03em; }
  .problem-copy > p { margin: .4rem 0 0; color: var(--color-ink-soft); font-size: .92rem; line-height: 1.45; }
  .problem-first { display: grid; gap: .2rem; margin-top: .9rem; border-top: 1px solid var(--color-line); padding-top: .65rem; }
  .problem-first span { color: var(--color-muted); font-size: .65rem; font-weight: 760; letter-spacing: .08em; text-transform: uppercase; }
  .problem-first strong { font-size: .83rem; line-height: 1.4; }
  .problem-copy > a { margin-top: auto; padding-top: .9rem; color: var(--color-accent-ink); font-size: .86rem; font-weight: 720; text-decoration: none; }
  .problem-copy > a:hover { color: var(--color-ink); }

  .problem-empty { margin: 1.5rem 0 0; border-left: 3px solid var(--color-accent); padding-left: 1rem; color: var(--color-muted); }
  .problem-empty[hidden] { display: none; }

  .problem-rule-band { background: var(--color-night); color: #f5f5f7; padding-block: clamp(3.5rem, 7vw, 6rem); }
  .rule-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); }
  .rule-grid ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: rgba(255,255,255,.14); }
  .rule-grid li { display: grid; align-content: start; gap: .25rem; background: var(--color-night); padding: 1rem; }
  .rule-grid li span { color: var(--color-accent); font-size: .7rem; font-weight: 760; }
  .rule-grid li strong { font-size: 1rem; }
  .rule-grid li p { margin: 0; color: rgba(245,245,247,.64); font-size: .86rem; line-height: 1.45; }

  @media (max-width: 850px) {
    .problem-hero-grid, .rule-grid { grid-template-columns: 1fr; }
    .problem-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .diagnostic-poster { gap: .15rem; }
    .diagnostic-poster :global(.symptom-icon) { max-width: 5rem; }
    .problem-card { grid-template-columns: 6.5rem 1fr; }
    .problem-visual { min-height: 12rem; padding: .45rem; }
    .rule-grid ol { grid-template-columns: 1fr; }
  }
</style>
