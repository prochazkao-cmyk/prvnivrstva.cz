---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExtrusionTrace from '../components/ExtrusionTrace.astro';
import { materials, materialSources } from '../data/materials';

const description =
  'Praktický přehled PLA, PETG, ASA a TPU: orientační rozsahy tisku, sušení, enclosure a typické použití. S uvedeným původem dat.';
---

<BaseLayout title="Materiály" description={description}>
  <main id="obsah">
    <section class="materials-hero">
      <div class="page materials-hero-grid">
        <div>
          <p class="kicker">Materiály · zdroje · praxe</p>
          <h1 class="page-title">Ne „jaká teplota na PETG“. Nejdřív který PETG.</h1>
          <p class="lede">
            Tohle je rychlá orientace, ne univerzální profil. Rozsahy níž vycházejí z veřejných materiálových guideů; přesný datasheet konkrétní cívky má přednost.
          </p>
          <div class="hero-actions materials-actions">
            <a class="btn btn-ink" href="#prehled">Porovnat materiály</a>
            <a class="btn btn-line" href="/clanky/suseni-filamentu-kdy-jak-cim/">Jak sušit filament</a>
          </div>
        </div>
        <div class="material-stack" aria-label="Materiálový profil">
          {materials.map((material, index) => (
            <div class="material-layer" style={`--i:${index}`}>
              <strong>{material.name}</strong>
              <span>{material.nozzle}</span>
            </div>
          ))}
        </div>
      </div>
      <ExtrusionTrace />
    </section>

    <section class="band" id="prehled" aria-labelledby="prehled-title">
      <div class="page">
        <div class="section-head">
          <div>
            <p class="kicker section-kicker-gap">Rychlý přehled</p>
            <h2 id="prehled-title" class="display">Čtyři materiály. Čtyři jiné kompromisy.</h2>
          </div>
          <label class="material-filter">
            <span class="sr-only">Filtrovat materiály</span>
            <input type="search" placeholder="PLA, venek, pružné…" data-material-filter />
          </label>
        </div>

        <div class="material-reference" data-material-list>
          {materials.map((material, index) => (
            <article class="material-ref" data-material-item data-search={`${material.name} ${material.short} ${material.bestFor} ${material.watchFor}`}>
              <header>
                <span class="material-index">M{String(index + 1).padStart(2, '0')}</span>
                <h3>{material.name}</h3>
                <p>{material.short}</p>
              </header>
              <dl>
                <div>
                  <dt>Tryska</dt>
                  <dd>{material.nozzle}</dd>
                </div>
                <div>
                  <dt>Podložka</dt>
                  <dd>{material.bed}</dd>
                </div>
                <div>
                  <dt>Sušení</dt>
                  <dd>{material.drying}</dd>
                </div>
                <div>
                  <dt>Enclosure</dt>
                  <dd>{material.enclosure}</dd>
                </div>
                <div>
                  <dt>Citlivost na vlhkost</dt>
                  <dd>{material.moisture}</dd>
                </div>
              </dl>
              <div class="material-use">
                <p><span>Hodí se</span>{material.bestFor}</p>
                <p><span>Pozor</span>{material.watchFor}</p>
              </div>
              <footer>
                <a href={material.sourceUrl} rel="noreferrer">Zdroj: {material.sourceLabel} ↗</a>
                <small>{material.sourceScope}</small>
              </footer>
            </article>
          ))}
        </div>
        <p class="atlas-empty" data-material-empty hidden>Nic tomu filtru neodpovídá. Zkuste PLA, PETG, venek nebo pružné.</p>
      </div>
    </section>

    <section class="source-band" aria-labelledby="source-title">
      <div class="page source-grid">
        <div>
          <p class="kicker kicker-light">Původ dat</p>
          <h2 id="source-title" class="display display-light">Tabulka bez zdroje je jen hezká dekorace.</h2>
          <p>
            Rozsahy jsou orientační. Výrobce konkrétního filamentu může doporučovat jiné nastavení a sušení — zejména u směsí, plniv a flexibilních materiálů.
          </p>
        </div>
        <ol>
          {materialSources.map((source, index) => (
            <li>
              <span>0{index + 1}</span>
              <a href={source.url} rel="noreferrer">{source.label} ↗</a>
              <p>{source.note}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="band">
      <div class="page next-step">
        <div>
          <p class="kicker">Další krok</p>
          <h2 class="display">Materiál vybraný. Teď ho nenechte zkazit profilem.</h2>
        </div>
        <div class="next-links">
          <a href="/rady-a-tipy/prvni-vrstva-nedrzi/">První vrstva nedrží <span>→</span></a>
          <a href="/rady-a-tipy/petg-a-struny/">PETG dělá struny <span>→</span></a>
          <a href="/clanky/warping-u-abs-priciny-a-checklist/">Warping u ABS / ASA <span>→</span></a>
          <a href="/nastroje/">Kalkulačky pro dílnu <span>→</span></a>
          <a href="/srovnavac/">Cena filamentu za kilogram <span>→</span></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLInputElement>('[data-material-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-material-item]')];
  const empty = document.querySelector<HTMLElement>('[data-material-empty]');
  const normalize = (value: string) => value.toLocaleLowerCase('cs').normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  filter?.addEventListener('input', () => {
    const query = normalize(filter.value.trim());
    let visible = 0;
    for (const item of items) {
      const show = !query || normalize(item.dataset.search ?? '').includes(query);
      item.hidden = !show;
      if (show) visible += 1;
    }
    if (empty) empty.hidden = visible > 0;
  });
</script>

<style>
  .materials-hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    border-bottom: 1px solid var(--color-line);
  }

  .materials-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .materials-actions { margin-top: 1.5rem; }

  .materials-hero :global(.extrusion-trace) {
    position: absolute;
    right: -9rem;
    bottom: -4rem;
    width: min(55rem, 70vw);
    color: var(--color-accent);
    opacity: .12;
    pointer-events: none;
  }

  .material-stack {
    display: grid;
    gap: .55rem;
    transform: rotate(-2deg);
  }

  .material-layer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, var(--color-line));
    border-radius: 999px;
    background: var(--color-card);
    padding: .85rem 1.2rem;
    box-shadow: 0 calc(var(--i) * 2px) 0 color-mix(in srgb, var(--color-accent) 22%, transparent);
    transform: translateX(calc(var(--i) * 1.1rem));
  }

  .material-layer strong { font-size: 1.1rem; }
  .material-layer span { color: var(--color-muted); font-variant-numeric: tabular-nums; }

  .material-filter input {
    width: min(18rem, 100%);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    padding: .7rem 1rem;
    color: var(--color-ink);
  }

  .material-reference {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .material-ref {
    display: grid;
    gap: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
    padding: clamp(1.2rem, 3vw, 1.8rem);
  }

  .material-ref[hidden] { display: none; }
  .material-ref header { display: grid; grid-template-columns: auto 1fr; gap: .2rem .7rem; align-items: baseline; }
  .material-index { color: var(--color-accent-ink); font-size: .72rem; font-weight: 760; letter-spacing: .08em; }
  .material-ref h3 { margin: 0; font-size: 1.65rem; }
  .material-ref header p { grid-column: 1 / -1; margin: .4rem 0 0; color: var(--color-ink-soft); }

  .material-ref dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem 1rem; margin: 0; }
  .material-ref dl div { border-top: 1px solid var(--color-line); padding-top: .55rem; }
  .material-ref dt { color: var(--color-muted); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .material-ref dd { margin: .22rem 0 0; font-weight: 650; }

  .material-use { display: grid; gap: .65rem; }
  .material-use p { display: grid; grid-template-columns: 4.5rem 1fr; gap: .7rem; margin: 0; color: var(--color-ink-soft); }
  .material-use span { color: var(--color-ink); font-size: .78rem; font-weight: 760; text-transform: uppercase; }

  .material-ref footer { display: grid; gap: .25rem; border-top: 1px solid var(--color-line); padding-top: .8rem; }
  .material-ref footer a { color: var(--color-accent-ink); font-size: .82rem; font-weight: 650; text-decoration: none; }
  .material-ref footer small { color: var(--color-muted); line-height: 1.45; }

  .source-band { background: var(--color-night); color: #f8f5ee; padding-block: clamp(3.5rem, 7vw, 6rem); }
  .source-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); }
  .source-grid > div > p:last-child { max-width: 34rem; color: #c8c2b6; }
  .source-grid ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(255,255,255,.16); }
  .source-grid li { display: grid; grid-template-columns: 2rem 1fr; gap: .3rem .8rem; border-bottom: 1px solid rgba(255,255,255,.16); padding: 1rem 0; }
  .source-grid li span { color: var(--color-accent); font-size: .72rem; font-weight: 760; }
  .source-grid li a { color: #fff; font-weight: 650; text-decoration: none; }
  .source-grid li p { grid-column: 2; margin: 0; color: #bdb6aa; font-size: .88rem; }

  .next-step { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .next-links { display: grid; border-top: 1px solid var(--color-line); }
  .next-links a { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--color-line); padding: 1rem 0; color: var(--color-ink); font-weight: 650; text-decoration: none; }
  .next-links a:hover { color: var(--color-accent-ink); }

  @media (max-width: 800px) {
    .materials-hero-grid, .source-grid, .next-step { grid-template-columns: 1fr; }
    .material-reference { grid-template-columns: 1fr; }
    .material-stack { margin-right: 2rem; }
    .materials-hero :global(.extrusion-trace) { width: 48rem; right: -22rem; }
  }
</style>
