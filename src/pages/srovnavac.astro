---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilamentOfferTable from '../components/FilamentOfferTable.astro';
import { filamentExampleOffers } from '../data/filament-fixtures';
import {
  groupOffers,
  isComparerIndexable,
  MIN_PUBLIC_SHOPS,
  offers,
  uniqueShopCount,
} from '../data/offers';

const productionOffers = offers.filter((offer) => offer.example !== true);
const shopCount = uniqueShopCount(productionOffers);
const indexable = isComparerIndexable(productionOffers);
const liveGroups = indexable ? groupOffers(productionOffers) : [];
/**
 * Fixture markup is compiled only for `astro dev`.
 * The static build inlines `import.meta.env.DEV` as false, so example prices
 * are not rendered into the Cloudflare Pages HTML.
 * `?preview=1` is read in the browser and only reveals that dev-only block.
 */
const previewGroups = import.meta.env.DEV ? groupOffers(filamentExampleOffers) : [];
---

<BaseLayout
  title="Srovnávač filamentu"
  description="Cena filamentu za kilogram z feedů obchodů. Doprava a sklad vedle Kč/kg. Dokud nejsou tři obchody, stránka není ve vyhledávání."
  noindex={!indexable}
>
  <main id="obsah" class="page section-page compare-page">
    <p class="kicker">FILAMENT · KČ/KG</p>
    <h1 class="page-title">Filament podle Kč/kg, ne podle provize.</h1>
    <p class="lede">
      Nejdřív cena materiálu za kilogram. Hmotnost musí přijít z feedu — když ji nejde přečíst, nabídku neukážeme a kilogram z názvu nevymyslíme. Doprava je v tabulce zvlášť a do výchozího pořadí nevstupuje. Tiskárny přijdou až po filamentech.
    </p>

    {previewGroups.length > 0 && (
      <div id="filament-preview" class="compare-preview-root">
        <script is:inline>
          if (new URLSearchParams(location.search).get('preview') === '1') {
            document.documentElement.classList.add('filament-preview');
          }
        </script>
        <section class="compare-preview" aria-labelledby="preview-title">
          <span>Náhled</span>
          <div>
            <h2 id="preview-title">Tahle čísla nejsou z obchodu.</h2>
            <p>
              Jsou to vymyšlené fixture nabídky (<code>manual-approved</code>, <code>example</code>). Slouží jen k prohlédnutí tabulky v <code>npm run dev</code> na adrese <code>/srovnavac/?preview=1</code>.
              Produkční brána je pořád {shopCount}/{MIN_PUBLIC_SHOPS} a stránka zůstává <code>noindex</code>. V buildu pro Cloudflare Pages se náhled nevykreslí.
            </p>
          </div>
        </section>
        <FilamentOfferTable groups={previewGroups} />
      </div>
    )}

    {liveGroups.length > 0 ? (
      <FilamentOfferTable groups={liveGroups} />
    ) : (
      <section class="compare-gate" aria-labelledby="gate-title">
        <span>{shopCount}/{MIN_PUBLIC_SHOPS}</span>
        <div>
          <h2 id="gate-title">Živé ceny filamentu ještě nemáme.</h2>
          <p>
            Veřejně stránku pustíme až po třech stabilních obchodech. Do té doby tu není ceník a ve vyhledávání ji neukazujeme.
            Napojení je jen XML, API nebo affiliate feed, který obchod poskytne nebo povolí. Výchozí pořadí bude Kč/kg produktu, ne výše provize a ne doprava.
          </p>
        </div>
      </section>
    )}

    <section class="method" aria-labelledby="method-title">
      <p class="kicker">PRAVIDLA</p>
      <h2 id="method-title">Co srovnávač filamentu nesmí dělat.</h2>
      <ul>
        <li>Provize nesmí měnit pořadí. Affiliate odkaz se jen označí.</li>
        <li>Kilogram bereme jen z pole hmotnosti ve feedu. Nápis „1 kg“ v názvu nestačí.</li>
        <li>Když hmotnost nejde přečíst, nabídku zahodíme. Nevymýšlíme ji a nedoplňujeme materiál na PLA.</li>
        <li>Stretch fólie a jiné ne-filamenty neprojdou, ani když je feed označí jako PLA.</li>
        <li>Neznámou dopravu nesčítáme jako nulu a neschováváme ji.</li>
        <li>Starou cenu neukážeme bez označení. Po 36 hodinách od stažení je řádek „starší 36 h“.</li>
        <li>Stejný název sám o sobě nabídky nesloučí. Společné productId vznikne jen z explicitní mapy.</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .compare-page { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .compare-preview-root { display: none; }
  :global(html.filament-preview) .compare-preview-root { display: block; }
  :global(html.filament-preview) .compare-gate { display: none; }
  .compare-gate,
  .compare-preview {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: center;
    margin: 2rem 0 2.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
    padding: clamp(1rem, 3vw, 1.5rem);
  }
  .compare-preview { align-items: start; border-style: dashed; }
  .compare-gate > span,
  .compare-preview > span {
    display: grid;
    place-items: center;
    width: 5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    color: #1a0d08;
    font-family: 'Iowan Old Style', 'Baskerville', serif;
    font-size: 1.35rem;
    font-weight: 700;
  }
  .compare-gate h2,
  .compare-preview h2 {
    margin: 0;
    font-family: 'Iowan Old Style', 'Baskerville', serif;
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    letter-spacing: -.035em;
  }
  .compare-gate p,
  .compare-preview p { max-width: 55rem; margin: .35rem 0 0; color: var(--color-muted); }
  .compare-preview code { font-size: .84em; }
  .method { margin-top: 4rem; }
  .method h2 { margin: .45rem 0 1rem; font-family: 'Iowan Old Style', 'Baskerville', serif; font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: -.04em; }
  .method ul { max-width: 55rem; padding-left: 1.2rem; }
  .method li { margin: .45rem 0; }
  @media (max-width: 620px) {
    .compare-gate,
    .compare-preview { grid-template-columns: 1fr; }
  }
</style>
