---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const live = [
  {
    title: 'Jak vybrat první 3D tiskárnu: 7 otázek',
    href: '/clanky/jak-vybrat-prvni-3d-tiskarnu-7-otazek/',
    copy: 'Nejdřív použití, materiál, komora a workflow. Až potom konkrétní model.',
    tag: 'Začít tady',
  },
  {
    title: 'Bambu Lab, nebo Prusa?',
    href: '/clanky/prusa-vs-bambu-lab-srovnani/',
    copy: 'Dva odlišné přístupy k ekosystému, servisu a používání tiskárny.',
    tag: 'Srovnání',
  },
];

const pipeline = [
  'Nejlepší 3D tiskárny 2026',
  'Nejlepší tiskárna pro začátečníky',
  'Nejlepší tiskárna do 10 000 Kč',
  'Nejlepší uzavřená tiskárna pro ASA a ABS',
  'Nejlepší sušičky filamentu v testu',
  'Nejlepší PLA filament od českých výrobců',
  'Nejlevnější filament v ČR',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Nákupní rádci První Vrstvy',
  url: new URL('/nakupni-radci/', site.url).href,
  inLanguage: 'cs',
};
---

<BaseLayout title="Nákupní rádci" description="Jak vybrat 3D tiskárnu a příslušenství podle použití, lokální ceny, servisu a skutečných kompromisů." jsonLd={jsonLd}>
  <main id="obsah" class="page section-page buying-hub">
    <p class="kicker">NÁKUPNÍ RÁDCI</p>
    <h1 class="page-title">Nejdřív rozhodnutí. Potom tlačítko Koupit.</h1>
    <p class="lede">Rádce nevzniká z affiliate provize. Pořadí musí stát na použití, datech a testech; česká cena, doprava a servis jsou součást rozhodnutí stejně jako technické parametry.</p>

    <div class="trust-row">
      <div><strong>Provize nemění pořadí.</strong><span>Affiliate odkaz bude označený přímo u nabídky.</span></div>
      <div><strong>Netestovaný stroj není „recenze“.</strong><span>Profil ze specifikací oddělujeme od vlastního testu.</span></div>
      <div><strong>Cena musí mít datum.</strong><span>Žádné falešné „aktuální ceny“, dokud neběží feed.</span></div>
    </div>

    <section aria-labelledby="live-title">
      <p class="kicker">PUBLIKOVÁNO</p>
      <h2 id="live-title" class="subhead">Začněte tím, co už má podklad.</h2>
      <div class="live-grid">
        {live.map((item) => (
          <a class="guide-card" href={item.href}>
            <span>{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <b>Otevřít →</b>
          </a>
        ))}
      </div>
    </section>

    <section class="pipeline" aria-labelledby="pipeline-title">
      <p class="kicker">DALŠÍ V POŘADÍ</p>
      <h2 id="pipeline-title" class="subhead">Žebříček vydáme až ve chvíli, kdy mu můžeme věřit.</h2>
      <p>Tyto stránky jsou připravené v redakčním backlogu. Veřejně je pustíme postupně s lokálními cenami, jasným původem dat a testy tam, kde tvrdíme něco o kvalitě.</p>
      <ol>
        {pipeline.map((title, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><strong>{title}</strong></li>)}
      </ol>
    </section>

    <aside class="article-next">
      <div>
        <p>Už víte, co chcete?</p>
        <h2>Podívejte se na konkrétní stroje.</h2>
        <span>Profily oddělují technické specifikace od redakční zkušenosti a od plných testů.</span>
      </div>
      <a href="/stroje/">Profily tiskáren <span aria-hidden="true">→</span></a>
    </aside>
  </main>
</BaseLayout>

<style>
  .buying-hub { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .trust-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 2rem 0 4rem; background: var(--color-line); border: 1px solid var(--color-line); }
  .trust-row > div { display: grid; gap: .25rem; background: var(--color-card); padding: 1rem; }
  .trust-row strong { font-size: .92rem; }
  .trust-row span { color: var(--color-muted); font-size: .82rem; line-height: 1.4; }
  .subhead { margin: .45rem 0 1.25rem; font-family: 'Iowan Old Style', 'Baskerville', serif; font-size: clamp(2rem, 4.5vw, 3.7rem); letter-spacing: -.045em; line-height: .98; }
  .live-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .guide-card { display: grid; min-height: 15rem; align-content: end; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-card); padding: 1.25rem; color: var(--color-ink); text-decoration: none; }
  .guide-card > span { color: var(--color-accent-ink); font-size: .7rem; font-weight: 760; letter-spacing: .08em; text-transform: uppercase; }
  .guide-card h3 { margin: .45rem 0 0; font-family: 'Iowan Old Style', 'Baskerville', serif; font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: -.035em; line-height: 1; }
  .guide-card p { color: var(--color-muted); }
  .guide-card b { font-size: .82rem; }
  .pipeline { margin-top: 4rem; }
  .pipeline > p:not(.kicker) { max-width: 60rem; color: var(--color-muted); }
  .pipeline ol { margin: 1.5rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--color-line); }
  .pipeline li { display: grid; grid-template-columns: 3rem 1fr; gap: .75rem; border-bottom: 1px solid var(--color-line); padding: .85rem 0; }
  .pipeline li span { color: var(--color-accent-ink); font-size: .8rem; font-weight: 760; }
  .pipeline li strong { font-size: .96rem; }
  .article-next { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: 3rem; border-radius: var(--radius-card); background: var(--color-night); padding: clamp(1.2rem, 3vw, 1.7rem); color: #f5f5f7; }
  .article-next > div { display: grid; gap: .25rem; }
  .article-next p { margin: 0; color: var(--color-accent); font-size: .7rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .article-next h2 { margin: 0; font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -.04em; }
  .article-next div > span { max-width: 48rem; color: rgba(245,245,247,.68); font-size: .92rem; }
  .article-next > a { display: inline-flex; flex: none; align-items: center; gap: .55rem; border-radius: 999px; background: var(--color-accent); padding: .7rem 1rem; color: #1a0d08; font-weight: 720; text-decoration: none; }
  @media (max-width: 760px) {
    .trust-row, .live-grid { grid-template-columns: 1fr; }
    .article-next { align-items: flex-start; flex-direction: column; }
  }
</style>
