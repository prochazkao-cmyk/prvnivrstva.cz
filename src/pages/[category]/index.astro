---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RankBoard from '../../components/RankBoard.astro';
import SpecTable from '../../components/SpecTable.astro';
import { getArticles } from '../../lib/articles';
import { categories, categoryOrder, isCategory } from '../../lib/categories';
import { textCount } from '../../lib/format';
import { buildRankCards } from '../../lib/rankings';
import type { CategoryId } from '../../lib/categories';

export async function getStaticPaths() {
  return categoryOrder.map((category) => ({
    params: { category },
  }));
}

const { category: categoryParam } = Astro.params;
if (!categoryParam || !isCategory(categoryParam)) {
  throw new Error(`Neznámá rubrika: ${categoryParam}`);
}

const categoryId = categoryParam as CategoryId;
const category = categories[categoryId];
const articles = await getArticles(categoryId);
const cards = categoryId === 'stroje' ? buildRankCards(articles) : [];
---

<BaseLayout title={category.label} description={category.intro}>
  <main id="obsah" class="page section-page">
    <nav class="crumbs" aria-label="Drobečková navigace">
      <a href="/">Úvod</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{category.label}</span>
    </nav>
    <p class="kicker">Rubrika</p>
    <h1 class="page-title">{category.label}</h1>
    <p class="lede">{category.intro}</p>
    <p class="meta">{textCount(articles.length)}</p>

    {
      categoryId === 'stroje' ? (
        <>
          <RankBoard cards={cards} cardHeading="h2" />
          <h2 class="subhead">Srovnání v číslech</h2>
          <p class="lede">
            Stejné stroje, vedle sebe. Hodnoty jsou z profilů a jsou orientační — před nákupem ověřte
            aktuální revizi u výrobce.
          </p>
          <SpecTable cards={cards} />
        </>
      ) : articles.length === 0 ? (
        <p class="lede">V téhle rubrice zatím nic neleží.</p>
      ) : (
        <div class="story-list">
          {articles.map((article) => (
            <ArticleCard article={article} heading="h2" variant="row" showCategory={false} />
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
