---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allCollections = await Promise.all([
  getCollection('clanky'),
  getCollection('rady-a-tipy'),
  getCollection('stroje'),
  getCollection('tiskarny'),
  getCollection('recenze'),
  getCollection('novinky'),
  getCollection('technologie'),
]);

const articles = allCollections.flat().map(art => {
  const visualCount = (art.body?.match(/!\[.*?\]\(.*?\)/g) || []).length;
  return {
    ...art.data,
    slug: art.id,
    collection: art.collection,
    visualCount,
  };
});

// Sort by publishedAt desc
articles.sort((a, b) => (b.publishedAt?.getTime() || 0) - (a.publishedAt?.getTime() || 0));
---
<BaseLayout title="Redakční Dashboard | První Vrstva" description="Interní přehled obsahu a stavu ověření.">
  <main class="container admin-shell">
    <header class="admin-head">
      <p class="eyebrow">INTERNÍ REDAKCE</p>
      <h1>Obsahový Dashboard</h1>
      <p>Přehled všech článků, jejich stavu a completeness vizuálů.</p>
    </header>

    <section class="admin-card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Článek</th>
              <th>Status</th>
              <th>Vizuály</th>
              <th>Evidence / Stav</th>
              <th>Zdroje</th>
            </tr>
          </thead>
          <tbody>
            {articles.map((art) => (
              <tr>
                <td>
                  {art.draft ? (
                    <span class="art-link draft-title">{art.title}</span>
                  ) : (
                    <a href={`/${art.collection}/${art.slug}/`} target="_blank" class="art-link">
                      {art.title}
                    </a>
                  )}
                  <div class="art-meta">{art.collection}</div>
                </td>
                <td>
                  <span class={`badge ${art.draft ? 'muted' : ''}`}>
                    {art.draft ? 'Draft' : 'Published'}
                  </span>
                </td>
                <td>
                  <span class={`visual-count ${art.visualCount < 5 ? 'incomplete' : 'complete'}`}>
                    {art.visualCount} / 5
                  </span>
                </td>
                <td>
                  <span class="badge-state">{art.evidence || 'redakce'}</span>
                </td>
                <td class="source-cell" title={art.sourceNote}>
                  {art.sourceNote ? 'Ano' : 'Ne'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .admin-shell{padding-top:3rem;padding-bottom:5rem;max-width:1200px}
  .admin-head{max-width:780px;margin-bottom:2rem}
  .eyebrow{font-size:.78rem;font-weight:800;letter-spacing:.12em;color:var(--accent,#f97316)}
  h1{font-size:clamp(2rem,6vw,4rem);margin:.2rem 0 .75rem}
  .admin-card{background:var(--surface,#fff);border:1px solid var(--border,#e5e7eb);border-radius:18px;padding:1.25rem;margin:1rem 0}
  .table-wrap{overflow:auto}
  table{width:100%;border-collapse:collapse;min-width:800px}
  th,td{text-align:left;padding:.8rem;border-bottom:1px solid var(--border,#e5e7eb);font-size:.9rem}
  th{font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted,#5f6368)}
  .art-link{font-weight:600;text-decoration:none;color:var(--text, #111);display:block}
  .art-link:hover{text-decoration:underline}
  .art-meta{font-size:.7rem;color:var(--muted,#5f6368)}
  .badge{display:inline-block;font-size:.68rem;font-weight:800;letter-spacing:.06em;padding:.3rem .5rem;border-radius:999px;background:#fff3e8;color:#b45309}
  .badge.muted{background:#f3f4f6;color:#4b5563}
  .visual-count{font-weight:700;font-size:.85rem}
  .visual-count.incomplete{color:#b45309}
  .visual-count.complete{color:#059669}
  .badge-state{font-size:.75rem;padding:.2rem .4rem;border-radius:4px;background:#f3f4f6;border:1px solid #e5e7eb}
  .source-cell{font-size:.85rem}
  @media(max-width:700px){.admin-shell{padding-top:1.5rem}.admin-card{padding:1rem}}
</style>
