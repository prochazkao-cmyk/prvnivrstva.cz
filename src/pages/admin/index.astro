---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allCollections = await Promise.all([
  getCollection('clanky'), getCollection('rady-a-tipy'), getCollection('stroje'),
  getCollection('tiskarny'), getCollection('recenze'), getCollection('novinky'), getCollection('technologie'),
]);
const articles = allCollections.flat().map((art) => {
  const body = art.body || '';
  return {
    title: art.data.title, description: art.data.description, slug: art.id, collection: art.collection,
    draft: art.data.draft, author: art.data.author, contentMode: art.data.contentMode,
    evidence: art.data.evidence, sourceNote: Boolean(art.data.sourceNote),
    reviewedAt: art.data.reviewedAt?.toISOString().slice(0, 10) || null,
    updatedAt: art.data.updatedAt?.toISOString().slice(0, 10) || null,
    publishedAt: art.data.publishedAt?.toISOString().slice(0, 10) || null,
    disclosure: Boolean(art.data.disclosure), affiliate: art.data.affiliate,
    visualCount: (body.match(/!\[.*?\]\(.*?\)/g) || []).length,
    internalLinks: (body.match(/\]\(\/(?!\/)/g) || []).length,
    sourceLinks: (body.match(/https?:\/\/[^\s)]+/g) || []).length,
    hasTakeaway: /Praktický závěr|Udělejte teď|Co zkontrolovat/i.test(body),
  };
}).sort((a, b) => a.title.localeCompare(b.title, 'cs'));
---
<BaseLayout title="Redakční Admin | První Vrstva" description="Interní redakční workflow První Vrstvy.">
  <main class="container admin-shell">
    <header class="admin-head"><div><p class="eyebrow">INTERNÍ REDAKCE</p><h1>Redakční workflow</h1><p>Vyber článek, připrav tematický vizuál, vygeneruj ho jednou, zkontroluj a schval.</p></div><button class="outline-button" id="clear-token" type="button">Odhlásit</button></header>
    <section class="admin-card token-card" id="token-card"><h2>Přístup do generátoru</h2><p>Token se uloží pouze do této záložky prohlížeče. Neposílej ho do článků ani do repozitáře.</p><div class="token-row"><input id="admin-token" type="password" autocomplete="off" placeholder="Admin access token" /><button class="button" id="save-token" type="button">Pokračovat</button></div><p class="form-error" id="token-error" hidden></p></section>
    <section class="workspace" id="workspace" hidden>
      <aside class="admin-card article-list"><div class="list-head"><h2>Články</h2><span class="count">{articles.length}</span></div><input class="search" id="article-search" type="search" placeholder="Hledat článek…" /><div class="articles" id="articles">{articles.map((article) => <button class="article-item" type="button" data-article={article.slug}><strong>{article.title}</strong><span>{article.draft ? 'Draft' : 'Published'} · {article.visualCount}/5 vizuálů</span></button>)}</div></aside>
      <section class="admin-card editor" id="editor"><div class="empty-state">Vyber článek vlevo.</div></section>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ articles }}>
  const slots = [['ecosystem', 'Ekosystém', 'Autorský přehled hlavních částí tématu a jejich vztahů.'], ['decision', 'Rozhodovací strom', 'Jednoduchý praktický strom, který čtenáře dovede k další volbě.'], ['materials', 'Materiály a parametry', 'Čisté redakční srovnání materiálů, parametrů nebo pracovních kroků.'], ['context', 'Kontext a použití', 'Workshopová scéna nebo technické schéma ukazující použití v praxi.'], ['checklist', 'Checklist', 'Přehledný vizuální checklist s pěti až sedmi konkrétními body.']];
  const models = [['recraft/recraft-v4.1-vector', 'Recraft Vector · SVG'], ['recraft/recraft-v4.1-flash', 'Recraft Flash · návrh'], ['openai/gpt-image-2', 'GPT Image 2 · vysoká kvalita']];
  const contentLabels = { 'redakcni': 'Redakční průvodce', 'zdrojovany-profil': 'Zdrojovaný profil', 'plny-test': 'Plný test / recenze' };
  const tokenKey = 'prvnivrstva-admin-token'; let selectedArticle = null;
  const tokenCard = document.querySelector('#token-card'), workspace = document.querySelector('#workspace'), tokenInput = document.querySelector('#admin-token'), tokenError = document.querySelector('#token-error'), editor = document.querySelector('#editor'), articleSearch = document.querySelector('#article-search');
  if (sessionStorage.getItem(tokenKey)) showWorkspace();
  document.querySelector('#save-token')?.addEventListener('click', () => { const token = tokenInput.value.trim(); if (token) { sessionStorage.setItem(tokenKey, token); showWorkspace(); } });
  document.querySelector('#clear-token')?.addEventListener('click', () => { sessionStorage.removeItem(tokenKey); location.reload(); });
  articleSearch?.addEventListener('input', () => { const query = articleSearch.value.toLocaleLowerCase('cs'); document.querySelectorAll('.article-item').forEach((item) => { item.hidden = !item.textContent.toLocaleLowerCase('cs').includes(query); }); });
  document.querySelectorAll('.article-item').forEach((item) => item.addEventListener('click', () => selectArticle(item.dataset.article)));
  function showWorkspace() { tokenCard.hidden = true; workspace.hidden = false; tokenError.hidden = true; }
  function selectArticle(slug) {
    selectedArticle = articles.find((article) => article.slug === slug); if (!selectedArticle) return;
    document.querySelectorAll('.article-item').forEach((item) => item.classList.toggle('selected', item.dataset.article === slug));
    editor.innerHTML = `<div class="editor-head"><div><p class="eyebrow">${selectedArticle.draft ? 'DRAFT' : 'PUBLISHED'}</p><h2>${escapeHtml(selectedArticle.title)}</h2></div><button class="outline-button open-article" type="button">Otevřít článek</button></div>${qualityCard()}<p class="editor-note">Každý slot je samostatný. Vygeneruj pouze chybějící nebo skutečně potřebný vizuál.</p><div class="slots">${slots.map(slotCard).join('')}</div><p class="form-error" id="generation-error" hidden></p>`;
    editor.querySelector('.open-article').addEventListener('click', () => window.open(`/${selectedArticle.collection}/${selectedArticle.slug}/`, '_blank'));
    editor.querySelectorAll('.generate-button').forEach((button) => button.addEventListener('click', () => generate(button.dataset.slot)));
  }
  function qualityCard() {
    const checks = [
      [selectedArticle.author, 'Autor uveden'],
      [selectedArticle.reviewedAt, 'Datum poslední kontroly'],
      [selectedArticle.sourceNote || selectedArticle.sourceLinks > 0, 'Zdroj nebo source note'],
      [selectedArticle.evidence !== 'vyrobce' || selectedArticle.sourceNote, 'Evidence má vysvětlení'],
      [selectedArticle.hasTakeaway, 'Praktický závěr / další krok'],
      [selectedArticle.internalLinks > 0, 'Interní prolinkování'],
      [selectedArticle.visualCount > 0, 'Vizuální prvek'],
      [!selectedArticle.affiliate || selectedArticle.disclosure, 'Affiliate disclosure'],
    ];
    const passed = checks.filter(([ok]) => ok).length;
    const gate = !selectedArticle.draft && passed === checks.length;
    return `<section class="quality-card"><div class="quality-head"><div><p class="eyebrow">REDAKČNÍ KARTA</p><h3>${contentLabels[selectedArticle.contentMode] || 'Obsah'}</h3><p>${escapeHtml(selectedArticle.description || '')}</p></div><span class="quality-score ${gate ? 'ready' : ''}">${passed}/${checks.length}</span></div><div class="facts"><span><b>Autor</b>${escapeHtml(selectedArticle.author)}</span><span><b>Evidence</b>${escapeHtml(selectedArticle.evidence)}</span><span><b>Publikováno</b>${escapeHtml(selectedArticle.publishedAt || '—')}</span><span><b>Kontrola</b>${escapeHtml(selectedArticle.reviewedAt || 'chybí')}</span><span><b>Zdroje</b>${selectedArticle.sourceLinks} odkazů · ${selectedArticle.sourceNote ? 'poznámka ano' : 'poznámka chybí'}</span><span><b>Odkazy</b>${selectedArticle.internalLinks} interních</span></div><div class="quality-checks">${checks.map(([ok, label]) => `<span class="quality-check ${ok ? 'pass' : 'fail'}">${ok ? '✓' : '!' } ${label}</span>`).join('')}</div><div class="gate-message ${gate ? 'ready' : ''}">${gate ? 'Článek splňuje základní publikační bránu.' : selectedArticle.draft ? 'Draft: před publikací doplň chybějící body a proveď lidskou kontrolu.' : 'Před publikací doplň chybějící body.'}</div></section>`;
  }
  function slotCard([id, name, detail]) { return `<article class="slot" data-slot-card="${id}"><div class="slot-top"><div><span class="slot-number">${slots.findIndex((item) => item[0] === id) + 1}</span><strong>${name}</strong></div><span class="slot-status" data-status="${id}">Čeká</span></div><p>${detail}</p><textarea class="prompt" data-prompt="${id}">${promptFor(name, detail)}</textarea><div class="slot-controls"><select class="model" data-model="${id}">${models.map(([value, label]) => `<option value="${value}">${label}</option>`).join('')}</select><button class="button generate-button" data-slot="${id}" type="button">Generovat</button></div><div class="preview" data-preview="${id}" hidden></div></article>`; }
  function promptFor(name, detail) { return `Editorial illustration for a Czech 3D printing magazine. Topic: ${selectedArticle.title}. Visual slot: ${name}. ${detail} Style: warm cream background, charcoal technical linework, orange accent, clean workshop editorial design, no brand logos, no fake measurements, no prices, no scores, no readable text inside the image, landscape 16:9 composition.`; }
  async function generate(slot) {
    const card = editor.querySelector(`[data-slot-card="${slot}"]`), button = card.querySelector('.generate-button'), status = card.querySelector('.slot-status'), prompt = card.querySelector('.prompt').value.trim(), model = card.querySelector('.model').value;
    button.disabled = true; button.textContent = 'Generuji…'; status.textContent = 'Probíhá';
    try {
      const response = await fetch('/api/admin/generate-image', { method: 'POST', headers: {'Content-Type': 'application/json', 'x-admin-token': sessionStorage.getItem(tokenKey) || ''}, body: JSON.stringify({prompt, model, aspectRatio: '16:9'}) });
      const result = await response.json(); if (!response.ok) throw new Error(result.error || 'Generování selhalo.');
      const preview = card.querySelector('.preview'); preview.hidden = false; preview.innerHTML = `<img src="${result.dataUrl}" alt="Náhled: ${escapeHtml(slot)}" /><div class="preview-actions"><button class="button approve-button" type="button">Schválit</button><button class="outline-button download-button" type="button">Stáhnout</button><button class="outline-button markdown-button" type="button">Markdown</button></div><small>Model: ${escapeHtml(result.model)}${result.usage?.cost ? ` · odhad: $${result.usage.cost}` : ''}</small>`;
      preview.querySelector('.approve-button').addEventListener('click', () => { status.textContent = 'Schváleno'; status.classList.add('approved'); localStorage.setItem(`approved:${selectedArticle.collection}/${selectedArticle.slug}/${slot}`, result.dataUrl); });
      preview.querySelector('.download-button').addEventListener('click', () => download(result.dataUrl, `${selectedArticle.slug}-${slot}.${result.mediaType.includes('svg') ? 'svg' : 'png'}`));
      preview.querySelector('.markdown-button').addEventListener('click', () => copyMarkdown(slot)); status.textContent = 'Náhled';
    } catch (error) { const box = editor.querySelector('#generation-error'); box.textContent = error instanceof Error ? error.message : 'Generování selhalo.'; box.hidden = false; status.textContent = 'Chyba'; }
    finally { button.disabled = false; button.textContent = 'Generovat'; }
  }
  function copyMarkdown(slot) { const dataUrl = localStorage.getItem(`approved:${selectedArticle.collection}/${selectedArticle.slug}/${slot}`); if (!dataUrl) return alert('Nejdřív obrázek schval. Stáhni ho a přidej do public/images.'); navigator.clipboard.writeText(`![${selectedArticle.title} – ${slot}](VLOŽ_CESTU_K_OBRÁZKU)`); }
  function download(dataUrl, filename) { const link = document.createElement('a'); link.href = dataUrl; link.download = filename; link.click(); }
  function escapeHtml(value) { return String(value).replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char])); }
</script>

<style>
  .admin-shell{padding:3rem 0 5rem;max-width:1320px}.admin-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-end;margin-bottom:2rem}.admin-head h1{font-size:clamp(2rem,6vw,4rem);margin:.2rem 0 .75rem}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.12em;color:var(--accent,#f97316);margin:0}.admin-card{background:var(--surface,#fff);border:1px solid var(--border,#e5e7eb);border-radius:18px;padding:1.25rem}.token-card{max-width:720px}.token-row{display:flex;gap:.6rem;margin-top:1rem}.token-row input,.search,.prompt,.model{font:inherit;border:1px solid var(--border,#d1d5db);border-radius:10px;padding:.7rem;background:var(--background,#fff);color:inherit}.token-row input{flex:1}.button,.outline-button{font:inherit;font-weight:700;border-radius:10px;padding:.65rem .9rem;cursor:pointer;border:1px solid #f97316}.button{background:#f97316;color:#fff}.button:disabled{opacity:.6;cursor:wait}.outline-button{background:transparent;color:inherit;text-decoration:none;display:inline-block}.workspace{display:grid;grid-template-columns:320px 1fr;gap:1rem}.list-head,.editor-head,.slot-top,.slot-controls,.preview-actions,.quality-head{display:flex;align-items:center;justify-content:space-between;gap:.7rem}.article-list{min-height:500px}.list-head h2,.editor-head h2{margin:.1rem 0 .8rem}.count{background:#f3f4f6;border-radius:999px;padding:.25rem .5rem;font-size:.75rem}.search{width:100%;margin:.5rem 0 1rem}.articles{display:grid;gap:.35rem;max-height:680px;overflow:auto}.article-item{border:0;border-radius:10px;text-align:left;padding:.7rem;background:transparent;cursor:pointer;color:inherit}.article-item:hover,.article-item.selected{background:#fff3e8}.article-item strong,.article-item span{display:block}.article-item span,.editor-note,.slot p,.token-card p{color:var(--muted,#5f6368);font-size:.82rem;line-height:1.5}.slots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.slot{border:1px solid var(--border,#e5e7eb);border-radius:14px;padding:1rem}.slot-top strong{margin-left:.45rem}.slot-number{display:inline-grid;place-items:center;width:1.5rem;height:1.5rem;border-radius:50%;background:#fff3e8;color:#b45309;font-weight:800;font-size:.75rem}.slot-status{font-size:.7rem;color:var(--muted,#5f6368)}.slot-status.approved{color:#059669;font-weight:700}.prompt{width:100%;min-height:120px;resize:vertical;line-height:1.45}.slot-controls{margin-top:.6rem}.model{max-width:55%;font-size:.8rem}.preview{margin-top:.8rem;border-top:1px solid var(--border,#e5e7eb);padding-top:.8rem}.preview img{display:block;width:100%;max-height:240px;object-fit:contain;background:#f7f3ed;border-radius:10px}.preview-actions{justify-content:flex-start;margin-top:.6rem;flex-wrap:wrap}.preview small{display:block;color:var(--muted,#5f6368);margin-top:.5rem}.form-error{color:#b91c1c!important;margin-top:.7rem}.empty-state{padding:4rem 1rem;text-align:center;color:var(--muted,#5f6368)}.quality-card{border:1px solid #dbe4e8;border-radius:14px;padding:1rem;margin:1rem 0;background:#fbfcfc}.quality-head{align-items:flex-start}.quality-head h3{margin:.15rem 0 .25rem}.quality-head p:not(.eyebrow){margin:0;color:var(--muted,#5f6368);font-size:.8rem;line-height:1.45}.quality-score{font-size:1.35rem;font-weight:800;color:#b45309}.quality-score.ready{color:#059669}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;margin:1rem 0}.facts span{font-size:.78rem;color:var(--muted,#5f6368)}.facts b{display:block;color:inherit;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.15rem}.quality-checks{display:flex;flex-wrap:wrap;gap:.4rem}.quality-check{border-radius:999px;padding:.35rem .5rem;font-size:.7rem}.quality-check.pass{background:#e8f7ef;color:#087443}.quality-check.fail{background:#fff1e9;color:#a83f08}.gate-message{margin-top:1rem;padding:.65rem .8rem;border-radius:9px;background:#fff1e9;color:#a83f08;font-size:.8rem}.gate-message.ready{background:#e8f7ef;color:#087443}
  @media(max-width:900px){.workspace{grid-template-columns:1fr}.articles{max-height:260px}.slots{grid-template-columns:1fr}.facts{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.admin-shell{padding-top:1.5rem}.admin-head{align-items:flex-start;flex-direction:column}.token-row{flex-direction:column}.slot-controls{align-items:stretch;flex-direction:column}.model{max-width:none}.facts{grid-template-columns:1fr}}
</style>
