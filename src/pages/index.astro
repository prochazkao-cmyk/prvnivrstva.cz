---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExtrusionTrace from '../components/ExtrusionTrace.astro';
import { site } from '../lib/site';
import { machineVisuals, materialVisuals, problemVisuals } from '../lib/visuals';

const heroPrusa = 'https://images.unsplash.com/photo-1742971500442-8fb8610dfbf5?auto=format&fit=crop&fm=jpg&q=84&w=2400';
const heroBambu = 'https://images.unsplash.com/photo-1762579318096-8e9bc45b8feb?auto=format&fit=crop&fm=jpg&q=84&w=2400';
const workshop = 'https://images.unsplash.com/photo-1758435170505-e9b2772348c1?auto=format&fit=crop&fm=jpg&q=82&w=2200';
const handPrint = 'https://images.unsplash.com/photo-1741764595674-3511fd1e2613?auto=format&fit=crop&fm=jpg&q=82&w=1800';
const workshopSpools = 'https://images.unsplash.com/photo-1760446410955-86c0446b9be2?auto=format&fit=crop&fm=jpg&q=82&w=1800';
const firstLayer = 'https://help.prusa3d.com/wp-content/uploads/First-Layer-Calibration-05-800x318.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'cs',
};
---

<BaseLayout title={`${site.name} — ${site.tagline}`} description={site.description} jsonLd={jsonLd}>
  <main id="obsah" class="home-ref">
    <section class="ref-hero" aria-labelledby="hero-title">
      <div class="ref-hero-grid">
        <div class="ref-hero-copy">
          <p class="ref-eyebrow">ZNALOSTI / TESTY / PRAXE / KOMUNITA</p>
          <h1 id="hero-title"><span>První</span><span>Vrstva<span class="ref-dot">.</span></span></h1>
          <h2>3D tisk bez chaosu.<br />Přehledně, lidsky, odborně.</h2>
          <p class="ref-hero-dek">Nezávislé testy, srozumitelné návody a praktické tipy pro každého, kdo chce z 3D tisku vytěžit maximum.</p>
          <div class="ref-actions">
            <a class="ref-btn ref-btn-accent" href="/clanky/">Prozkoumat články <span aria-hidden="true">→</span></a>
            <a class="ref-btn ref-btn-ghost" href="/o-nas/">O nás</a>
          </div>
        </div>

        <div class="ref-hero-media">
          <img class="theme-shot prusa-shot" src={heroPrusa} alt="Makro detail trysky 3D tiskárny při tisku" fetchpriority="high" decoding="async" />
          <img class="theme-shot bambu-shot" src={heroBambu} alt="Makro detail tiskové hlavy Bambu Lab při tisku" fetchpriority="high" decoding="async" />
          <p class="ref-handnote">Všechno<br />začíná první<br />vrstvou.</p>
          <p class="ref-smallnote">Malé detaily.<br /><strong>Velké možnosti.</strong></p>
          <span class="ref-photo-credit">Foto: Unsplash</span>
        </div>
      </div>
      <ExtrusionTrace className="ref-hero-trace" />
    </section>

    <nav class="ref-value-rail" aria-label="Hlavní témata">
      <ExtrusionTrace className="ref-rail-trace" />
      <div class="page ref-value-grid">
        <a href="/recenze/" class="ref-value">
          <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="16"/><circle cx="24" cy="24" r="7"/><circle cx="24" cy="24" r="2"/></svg>
          <strong>Přesnost</strong><small>Každý detail se počítá</small>
        </a>
        <a href="/nastroje/" class="ref-value">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M27 5 14 26h10l-3 17 14-23H25z"/></svg>
          <strong>Rychlost</strong><small>Méně čekání, více tisku</small>
        </a>
        <a href="/materialy/" class="ref-value">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="m24 8 15 8-15 8-15-8z"/><path d="m9 24 15 8 15-8"/><path d="m9 32 15 8 15-8"/></svg>
          <strong>Materiály</strong><small>Od PLA po technické směsi</small>
        </a>
        <a href="/rady-a-tipy/z-offset/" class="ref-value">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 13h32M8 24h32M8 35h32"/><circle cx="17" cy="13" r="4"/><circle cx="31" cy="24" r="4"/><circle cx="21" cy="35" r="4"/></svg>
          <strong>Kalibrace</strong><small>Lepší výsledky krok za krokem</small>
        </a>
        <a href="/rady-a-tipy/" class="ref-value">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 10c7-2 12 0 16 4v25c-4-4-9-6-16-4zM40 10c-7-2-12 0-16 4v25c4-4 9-6 16-4z"/></svg>
          <strong>Návody</strong><small>Srozumitelně a prakticky</small>
        </a>
      </div>
    </nav>

    <section class="ref-projects" aria-labelledby="projects-title">
      <div class="page ref-project-grid">
        <div class="ref-project-copy">
          <p class="ref-eyebrow">VÍCE NEŽ JEN TISK</p>
          <h2 id="projects-title">Skutečné projekty.<br />Skuteční lidé.</h2>
          <p>Inspirace z dílny, testy v reálných podmínkách a zkušenosti, které vám ušetří čas i materiál.</p>
          <a class="ref-btn ref-btn-ghost" href="/o-nas/">Nahlédnout do dílny <span aria-hidden="true">→</span></a>
        </div>

        <figure class="ref-project-photo ref-project-workshop">
          <img src={workshop} alt="Pracovní stůl s 3D tiskárnou a nářadím" loading="lazy" decoding="async" />
          <figcaption>Reálná dílna · Unsplash</figcaption>
        </figure>
        <figure class="ref-project-photo ref-project-hand">
          <img src={handPrint} alt="Ruka držící čerstvě vytištěný 3D díl" loading="lazy" decoding="async" />
        </figure>
        <figure class="ref-project-photo ref-project-spools">
          <img class="theme-shot prusa-shot" src={materialVisuals.prusament.src} alt={materialVisuals.prusament.alt} loading="lazy" decoding="async" />
          <img class="theme-shot bambu-shot" src={materialVisuals.bambu.src} alt={materialVisuals.bambu.alt} loading="lazy" decoding="async" />
        </figure>
        <figure class="ref-project-photo ref-project-object">
          <img src={workshopSpools} alt="3D tiskárna, filamenty a hotové výtisky na pracovním stole" loading="lazy" decoding="async" />
        </figure>
      </div>
      <ExtrusionTrace className="ref-project-trace" />
    </section>

    <section class="ref-numbers" aria-labelledby="numbers-title">
      <div class="page ref-number-grid">
        <div class="ref-number-intro">
          <p class="ref-eyebrow">TECHNICKÉ ZÁKLADY</p>
          <h2 id="numbers-title">Důležitá čísla,<br />která dělají rozdíl.</h2>
          <p>Přehled klíčových parametrů 3D tisku, které by měl znát každý. Srozumitelně, s příklady a v praxi.</p>
        </div>

        <article class="ref-number-card">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M18 5h12v10l-4 8v9h-4v-9l-4-8z"/><path d="M12 37h24M16 42h16"/></svg>
          <small>Průměr trysky</small><strong>0,4 mm</strong><p>0,2 / 0,4 / 0,6 / 0,8</p><em>Univerzální volba pro většinu tisků</em>
        </article>
        <article class="ref-number-card">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 12h28M13 18h25M10 24h28M13 30h25M10 36h28"/></svg>
          <small>Výška vrstvy</small><strong>0,20 mm</strong><p>0,08–0,32 mm</p><em>Nižší vrstva = více detailů</em>
        </article>
        <article class="ref-number-card">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="m24 6 15 8v20l-15 8-15-8V14z"/><path d="m9 14 15 8 15-8M24 22v20"/></svg>
          <small>Tiskový objem</small><strong>250 × 250</strong><p>× 250 mm</p><em>Běžná velikost domácí tiskárny</em>
        </article>
        <article class="ref-number-card ref-temp-card">
          <small>Teploty materiálů</small>
          <p><b><i class="dot pla"></i>PLA</b><span>190–220 °C</span></p>
          <p><b><i class="dot petg"></i>PETG</b><span>220–250 °C</span></p>
          <p><b><i class="dot abs"></i>ABS</b><span>230–260 °C</span></p>
          <p><b><i class="dot asa"></i>ASA</b><span>240–260 °C</span></p>
          <p><b><i class="dot tpu"></i>TPU</b><span>210–240 °C</span></p>
        </article>
        <article class="ref-number-card ref-quality-card">
          <small>Kvalita tisku</small>
          <div class="quality-pair">
            <div><img src={firstLayer} alt="Hrubší vrstvy 3D tisku" loading="lazy" decoding="async" /><b>0,32 mm</b><span>Rychlejší tisk</span></div>
            <div><img src={firstLayer} alt="Jemnější vrstvy 3D tisku" loading="lazy" decoding="async" /><b>0,08 mm</b><span>Více detailů</span></div>
          </div>
        </article>
      </div>
      <ExtrusionTrace className="ref-number-trace" />
    </section>

    <section class="ref-topics" id="temata" aria-labelledby="topics-title">
      <div class="page">
        <div class="ref-topic-head">
          <div>
            <p class="ref-eyebrow">OBJEVTE HLAVNÍ TÉMATA</p>
            <h2 id="topics-title">Vše pro lepší<br />3D tisk na jednom místě.</h2>
          </div>
          <p>Recenze, návody, srovnání a praktické tipy. Vyberte si téma, které vás zajímá, a posuňte svůj 3D tisk na další úroveň.</p>
        </div>

        <div class="ref-topic-grid">
          <a class="ref-topic-card" href="/recenze/">
            <div class="ref-topic-photo">
              <img class="theme-shot prusa-shot contain" src={machineVisuals['prusa-mk4s'].src} alt={machineVisuals['prusa-mk4s'].alt} loading="lazy" decoding="async" />
              <img class="theme-shot bambu-shot contain" src={machineVisuals['bambu-p1s-x1c'].src} alt={machineVisuals['bambu-p1s-x1c'].alt} loading="lazy" decoding="async" />
            </div>
            <div><strong>Testy tiskáren</strong><p>Nezávislé recenze, reálné zkušenosti, plusy a mínusy.</p><span>→</span></div>
          </a>
          <a class="ref-topic-card" href="/materialy/">
            <div class="ref-topic-photo">
              <img class="theme-shot prusa-shot" src={materialVisuals.prusament.src} alt={materialVisuals.prusament.alt} loading="lazy" decoding="async" />
              <img class="theme-shot bambu-shot" src={materialVisuals.bambu.src} alt={materialVisuals.bambu.alt} loading="lazy" decoding="async" />
            </div>
            <div><strong>Materiály</strong><p>Vlastnosti, použití, nastavení a srovnání filamentů.</p><span>→</span></div>
          </a>
          <a class="ref-topic-card" href="/rady-a-tipy/z-offset/">
            <div class="ref-topic-photo"><img src={firstLayer} alt="Kalibrace první vrstvy 3D tisku" loading="lazy" decoding="async" /></div>
            <div><strong>Kalibrace</strong><p>Postupně, srozumitelně a s měřitelnými výsledky.</p><span>→</span></div>
          </a>
          <a class="ref-topic-card" href="/clanky/prusa-vs-bambu-lab-srovnani/">
            <div class="ref-topic-photo ref-compare-photo">
              <img src={machineVisuals['prusa-mk4s'].src} alt="Prusa MK4S" loading="lazy" decoding="async" />
              <img src={machineVisuals['bambu-p1s-x1c'].src} alt="Bambu Lab P1S" loading="lazy" decoding="async" />
            </div>
            <div><strong>Srovnání</strong><p>Porovnání tiskáren, materiálů a nastavení v praxi.</p><span>→</span></div>
          </a>
          <a class="ref-topic-card" href="/rady-a-tipy/">
            <div class="ref-topic-photo"><img src={problemVisuals.stringing.src} alt={problemVisuals.stringing.alt} loading="lazy" decoding="async" /></div>
            <div><strong>Tipy a návody</strong><p>Praktické rady, triky a řešení nejčastějších problémů.</p><span>→</span></div>
          </a>
        </div>
      </div>
      <ExtrusionTrace className="ref-topic-trace" />
    </section>

    <section class="ref-community" aria-labelledby="community-title">
      <div class="page ref-community-grid">
        <div><p class="ref-eyebrow">KOMUNITA / ZKUŠENOSTI / LEPŠÍ VÝSLEDKY</p><h2 id="community-title">Společně tvoříme lepší 3D tisk.</h2></div>
        <p>Přidejte se k lidem, kteří sdílí zkušenosti, řeší problémy a posouvají 3D tisk dál.</p>
        <a class="ref-btn ref-btn-accent" href="/o-nas/">Staňte se součástí <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
