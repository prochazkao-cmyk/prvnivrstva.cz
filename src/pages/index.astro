---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HeroPrint from '../components/HeroPrint.astro';
import RankBoard from '../components/RankBoard.astro';
import RubrikaIndex from '../components/RubrikaIndex.astro';
import { getArticles } from '../lib/articles';
import { categoryOrder } from '../lib/categories';
import { machineCount } from '../lib/format';
import { buildRankCards } from '../lib/rankings';
import { site } from '../lib/site';

const articles = await getArticles();
const cards = buildRankCards(articles.filter((article) => article.category === 'stroje'));
const lead = articles.find((article) => article.hero) ?? articles.find((article) => article.featured) ?? articles[0];
const reading = articles.filter((article) => article.href !== lead?.href).slice(0, 4);
const news = articles.find((article) => article.category === 'novinky' && article.href !== lead?.href);
const counts = Object.fromEntries(
  categoryOrder.map((id) => [id, articles.filter((article) => article.category === id).length]),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'cs',
};
---

<BaseLayout title={`${site.name} — ${site.tagline}`} description={site.description} jsonLd={jsonLd} tone="dark">
  <main id="obsah">
    <section class="hero" aria-labelledby="hero-title">
      <div class="page">
        <p class="kicker kicker-light">L01 · Redakce</p>
        <h1 id="hero-title" class="hero-title">
          První vrstva,<br />která drží.
        </h1>
        <p class="hero-dek">
          Redakční rozcestník 3D tisku pro Česko a EU. {machineCount(cards.length)} v katalogu — u
          každého víme, proč ho doporučit a komu ne.
        </p>
        <div class="hero-actions">
          <a class="btn btn-light" href="#zebricek">Žebříček strojů</a>
          <a class="btn btn-text" href="/stroje/">Celý katalog →</a>
        </div>
      </div>
      <div class="hero-stage">
        <HeroPrint />
      </div>
    </section>

    <section class="band" id="zebricek" aria-labelledby="zebricek-title">
      <div class="page">
        <p class="kicker section-kicker-gap">L02 · Stroje</p>
        <h2 id="zebricek-title" class="display">Nejlepší 3D tiskárny právě teď</h2>
        <p class="lede">
          Pořadí pro běžnou dílnu. Stejná známka neznamená stejný stroj — štítek říká, k čemu sedí.
        </p>
        <RankBoard cards={cards} cardHeading="h3" />
      </div>
    </section>

    <section class="band" id="rubriky" style="padding-top: 0" aria-labelledby="rubriky-title">
      <div class="page">
        <p class="kicker section-kicker-gap">L03 · Rubriky</p>
        <h2 id="rubriky-title" class="display">Šest šuplíků.</h2>
        <p class="lede">Každý text má praktický závěr. Žádný unboxing, žádný slevový kód.</p>
        <RubrikaIndex counts={counts} />
      </div>
    </section>

    {
      lead && (
        <section class="band" style="padding-top: 0" aria-labelledby="cteni-title">
          <div class="page">
            <p class="kicker section-kicker-gap">L04 · Z dílny</p>
            <h2 id="cteni-title" class="display">Co číst, když vybíráte</h2>
            <div class="story-list">
              <ArticleCard article={lead} heading="h3" variant="lead" />
              {reading.map((article) => (
                <ArticleCard article={article} heading="h3" variant="row" />
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      news && (
        <section class="band" style="padding-top: 0" aria-labelledby="novinky-title">
          <div class="page">
            <p class="kicker section-kicker-gap">Novinky</p>
            <h2 id="novinky-title" class="display">
              <a href={news.href}>{news.title}</a>
            </h2>
            <p class="lede">{news.description}</p>
            <p class="meta">
              <a href="/novinky/">Celá rubrika</a>
            </p>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  #novinky-title a,
  .display a {
    color: inherit;
    text-decoration: none;
  }

  #novinky-title a:hover {
    color: var(--color-accent-ink);
  }

  .meta a {
    color: var(--color-accent-ink);
    font-weight: 620;
    text-decoration: none;
  }

  .meta a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
