---
import BrandMark from './BrandMark.astro';
import { categories, categoryOrder } from '../lib/categories';
import { site } from '../lib/site';
---

<footer class="site-footer">
  <div class="page footer-grid">
    <div>
      <BrandMark />
      <p class="footer-name">{site.name}</p>
      <p class="footer-dek">
        Nezávislý 3D tisk pro Česko a Slovensko. Servisní zkušenost, vlastní měření, lokální data a obsah, který vede ke konkrétnímu rozhodnutí.
      </p>
    </div>
    <div>
      <p class="kicker kicker-light">Rubriky</p>
      <ul class="footer-links">
        {categoryOrder.map((id) => (
          <li><a class="footer-link" href={categories[id].href}>{categories[id].label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="kicker kicker-light">Začněte tady</p>
      <ul class="footer-links">
        <li><a class="footer-link" href="/problemy/">Vyřešit problém</a></li>
        <li><a class="footer-link" href="/#zebricek">Vybrat tiskárnu</a></li>
        <li><a class="footer-link" href="/materialy/">Materiály</a></li>
        <li><a class="footer-link" href="/nastroje/">Nástroje</a></li>
      </ul>
    </div>
    <div>
      <p class="kicker kicker-light">Důvěra a kontakt</p>
      <ul class="footer-links">
        <li><a class="footer-link" href="/metodika/">Jak testujeme</a></li>
        <li><a class="footer-link" href="/autor/ondrej-prochazka/">Autor a servisní praxe</a></li>
        <li><a class="footer-link" href="/spoluprace/">Spolupráce pro firmy</a></li>
        <li><a class="footer-link" href="/o-nas/">O nás</a></li>
        <li><a class="footer-link" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bar">
    <div class="page footer-bar-inner">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <a class="footer-link" href="/sitemap-index.xml">Mapa stránek</a>
    </div>
  </div>
</footer>
