---
import BrandMark from './BrandMark.astro';
import { categories, categoryOrder } from '../lib/categories';
import { site } from '../lib/site';
---

<footer class="site-footer">
  <div class="page footer-grid">
    <div>
      <BrandMark />
      <p class="footer-name">{site.name}</p>
      <p class="footer-dek">
        Katalog a redakce 3D tisku pro Česko a EU. Píšeme z dílny: co drží na desce, co se vyplatí
        opravovat a co je jen nápis na krabici.
      </p>
    </div>
    <div>
      <p class="kicker kicker-light">Rubriky</p>
      <ul class="footer-links">
        {
          categoryOrder.map((id) => (
            <li>
              <a class="footer-link" href={categories[id].href}>
                {categories[id].label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="kicker kicker-light">Na úvodu</p>
      <ul class="footer-links">
        <li><a class="footer-link" href="/#zebricek">Žebříček</a></li>
        <li><a class="footer-link" href="/#pruvodce">Průvodce</a></li>
        <li><a class="footer-link" href="/#poradna">Poradna</a></li>
        <li><a class="footer-link" href="/#naradi">Nástroje</a></li>
      </ul>
    </div>
    <div>
      <p class="kicker kicker-light">Kontakt</p>
      <p class="footer-dek">
        Redakční schránka je zatím zástupná. Až poběží, bude to tahle adresa.
      </p>
      <p class="footer-links">
        <a class="footer-link" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="footer-links">
        <a class="footer-link" href="/o-nas/">O nás</a>
      </p>
    </div>
  </div>
  <div class="footer-bar">
    <div class="page footer-bar-inner">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <a class="footer-link" href="/sitemap-index.xml">Mapa stránek</a>
    </div>
  </div>
</footer>
