---
import { formatPriceCzk, formatScoreBadge, machineCount } from '../lib/format';
import { editorialNote, rankFilters, type RankCard } from '../lib/rankings';
import { machineVisuals } from '../lib/visuals';

interface Props {
  cards: RankCard[];
  cardHeading?: 'h2' | 'h3';
}

const { cards, cardHeading = 'h3' } = Astro.props;
const Heading = cardHeading;
---

<div data-rank-board>
  <div class="rank-toolbar">
    <div class="filter-row" role="group" aria-label="Filtr strojů">
      {
        rankFilters.map((filter, index) => (
          <button
            type="button"
            class="chip"
            data-filter={filter.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {filter.label}
          </button>
        ))
      }
    </div>
    <p class="rank-count" data-count aria-live="polite">{machineCount(cards.length)}</p>
  </div>

  <div class="rank-grid">
    {
      cards.map((card) => {
        const visual = machineVisuals[card.id];
        return (
          <article
            class="rank-card"
            data-card
            data-tags={card.filters.join(',')}
            data-price={card.priceFrom ?? ''}
          >
            <div class:list={['rank-photo', { 'has-real-photo': Boolean(visual) }]}>
              {visual && <img src={visual.src} alt={visual.alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
              <span class="badge-num">PV {String(card.order).padStart(2, '0')}</span>
              <span class="badge-cat">{card.badge}</span>
              {visual ? <span class="photo-credit">{visual.source}</span> : <span class="photo-label">{card.photoLabel}</span>}
              <span class="photo-scanline" aria-hidden="true" />
            </div>
            <div class="rank-body">
              <Heading class="rank-name">
                <a href={card.href}>{card.name}</a>
              </Heading>
              <p class="rank-spec">{card.specLine}</p>
              <div class="rank-score">
                {card.score !== null && !card.scoreDraft ? (
                  <span class="score-orb">
                    {formatScoreBadge(card.score)}
                    <span class="sr-only"> z 10</span>
                  </span>
                ) : (
                  <span class="score-orb score-orb-empty" aria-hidden="true">
                    —
                  </span>
                )}
                <div>
                  <p class="score-kicker">{card.scoreDraft ? 'Bez ověřené známky' : 'Redakční skóre'}</p>
                  {card.reviewHref ? (
                    <a class="score-caption" href={card.reviewHref}>
                      {card.scoreCaption}
                    </a>
                  ) : (
                    <p class="score-caption">{card.scoreCaption}</p>
                  )}
                </div>
              </div>
              <p class="rank-blurb">{card.blurb}</p>
              <div class="rank-foot">
                <div>
                  {card.priceFrom !== null ? (
                    <p class="price">
                      <span class="price-prefix">od</span>
                      {formatPriceCzk(card.priceFrom)}
                    </p>
                  ) : (
                    <p class="price">{card.priceCaption}</p>
                  )}
                  {card.priceFrom !== null && <p class="price-note">{card.priceCaption}</p>}
                </div>
                <a class="arrow-btn" href={card.href} aria-label={`Otevřít profil: ${card.name}`}>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path
                      d="M3 8h10M9 4l4 4-4 4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <p class="rank-empty" data-empty hidden>
    V tomhle řezu teď nemáme stroj, který bychom sem férově zařadili.
  </p>
  <p class="editorial-note">{editorialNote}</p>
</div>

<script>
  import { machineCount } from '../lib/format';

  type RankState = { budget: string; who: string; material: string };

  function bind(board: HTMLElement) {
    const root = board.closest<HTMLElement>('[data-rank-root]') ?? board;
    const buttons = [...board.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...board.querySelectorAll<HTMLElement>('[data-card]')];
    const empty = board.querySelector<HTMLElement>('[data-empty]');
    const count = board.querySelector<HTMLElement>('[data-count]');
    const budget = root.querySelector<HTMLSelectElement>('[data-budget]');
    const who = root.querySelector<HTMLSelectElement>('[data-who]');
    const material = root.querySelector<HTMLSelectElement>('[data-material]');
    const state: RankState = { budget: 'all', who: 'all', material: 'all' };

    const chipFor = (next: RankState) => {
      const active = [next.budget, next.who, next.material].filter((value) => value !== 'all');
      if (active.length === 0) return 'all';
      if (active.length === 1 && active[0] !== 'do-15000' && active[0] !== 'pla') return active[0];
      return '';
    };

    const apply = () => {
      let visible = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
        const price = Number(card.dataset.price);
        const ceiling = state.budget === 'do-10000' ? 10000 : state.budget === 'do-15000' ? 15000 : null;
        const budgetOk = ceiling === null || (Number.isFinite(price) && price > 0 && price <= ceiling);
        const show =
          budgetOk &&
          (state.who === 'all' || tags.includes(state.who)) &&
          (state.material === 'all' || tags.includes(state.material));
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (empty) empty.hidden = visible !== 0;
      if (count) count.textContent = machineCount(visible);
      const chip = chipFor(state);
      for (const button of buttons) {
        button.setAttribute('aria-pressed', button.dataset.filter === chip ? 'true' : 'false');
      }
      if (budget) budget.value = state.budget;
      if (who) who.value = state.who;
      if (material) material.value = state.material;
    };

    const readSelects = () => {
      state.budget = budget?.value ?? 'all';
      state.who = who?.value ?? 'all';
      state.material = material?.value ?? 'all';
      apply();
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        state.budget = 'all';
        state.who = 'all';
        state.material = 'all';
        if (filter === 'do-10000') state.budget = 'do-10000';
        else if (filter === 'zacatecnik') state.who = 'zacatecnik';
        else if (filter === 'uzavrene' || filter === 'multimaterial' || filter === 'resin') state.material = filter;
        apply();
      });
    }

    for (const select of [budget, who, material]) {
      select?.addEventListener('change', readSelects);
    }
    root.querySelector('[data-finder-go]')?.addEventListener('click', () => {
      readSelects();
      board.querySelector('.rank-grid')?.scrollIntoView({ block: 'nearest' });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-rank-board]').forEach((board) => bind(board));
</script>
