---
/** Simple transparent correction: current flow × target / measured. */
---

<form class="flow-tool" data-flow-tool>
  <div class="flow-head">
    <div>
      <p class="flow-kicker">Extruze</p>
      <h3>Korekce flow podle měření</h3>
    </div>
    <span>vzorec je vidět</span>
  </div>
  <p class="flow-lead">Pomocník pro postup, kde skutečně měříte vhodný kalibrační díl. Není to univerzální náhrada za metodiku vašeho sliceru.</p>

  <div class="flow-fields">
    <label>
      Aktuální flow [%]
      <input name="current" type="number" min="1" step="0.1" value="100" inputmode="decimal" />
    </label>
    <label>
      Cíl [mm]
      <input name="target" type="number" min="0.01" step="0.01" value="0.45" inputmode="decimal" />
    </label>
    <label>
      Naměřeno [mm]
      <input name="measured" type="number" min="0.01" step="0.01" value="0.47" inputmode="decimal" />
    </label>
  </div>

  <div class="flow-result">
    <div>
      <small>Výpočet</small>
      <code data-formula>100 × 0,45 / 0,47</code>
    </div>
    <div>
      <small>Nový flow</small>
      <strong data-flow-out>95,7 %</strong>
    </div>
  </div>

  <p class="flow-note">Výsledek zaokrouhlete rozumně a ověřte druhým tiskem. Měření jedné stěny může být ovlivněno line width, tlakem v trysce i geometrií testu.</p>
  <a class="flow-link" href="/rady-a-tipy/kalibrace-flow/">Otevřít celý postup →</a>
</form>

<script>
  const format = new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 2 });

  function bindFlow(form: HTMLFormElement) {
    const current = form.querySelector<HTMLInputElement>('[name="current"]');
    const target = form.querySelector<HTMLInputElement>('[name="target"]');
    const measured = form.querySelector<HTMLInputElement>('[name="measured"]');
    const out = form.querySelector<HTMLElement>('[data-flow-out]');
    const formula = form.querySelector<HTMLElement>('[data-formula]');

    const render = () => {
      const c = Number(current?.value);
      const t = Number(target?.value);
      const m = Number(measured?.value);
      if (!Number.isFinite(c) || !Number.isFinite(t) || !Number.isFinite(m) || c <= 0 || t <= 0 || m <= 0) {
        if (out) out.textContent = '—';
        if (formula) formula.textContent = '—';
        return;
      }
      const next = c * (t / m);
      if (formula) formula.textContent = `${format.format(c)} × ${format.format(t)} / ${format.format(m)}`;
      if (out) out.textContent = `${format.format(next)} %`;
    };

    [current, target, measured].forEach((input) => input?.addEventListener('input', render));
    render();
  }

  document.querySelectorAll<HTMLFormElement>('[data-flow-tool]').forEach(bindFlow);
</script>

<style>
  .flow-tool {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
    padding: clamp(1.15rem, 3vw, 1.6rem);
    box-shadow: var(--shadow-card);
  }

  .flow-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .flow-kicker { margin: 0 0 .25rem; color: var(--color-accent-ink); font-size: .68rem; font-weight: 760; text-transform: uppercase; letter-spacing: .1em; }
  .flow-head h3 { margin: 0; font-size: 1.25rem; }
  .flow-head > span { color: var(--color-muted); font-size: .72rem; }
  .flow-lead, .flow-note { color: var(--color-muted); line-height: 1.5; }
  .flow-lead { margin: .5rem 0 0; }
  .flow-note { margin: .9rem 0 0; font-size: .85rem; }

  .flow-fields { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-top: 1rem; }
  .flow-fields label { display: grid; gap: .25rem; color: var(--color-muted); font-size: .72rem; font-weight: 700; text-transform: uppercase; }
  .flow-fields input { width: 100%; border: 1px solid var(--color-line); border-radius: .7rem; background: #fff; padding: .62rem; color: var(--color-ink); font-size: 1.05rem; }
  .flow-fields input:focus { border-color: var(--color-accent); outline: 3px solid color-mix(in srgb, var(--color-accent) 18%, transparent); }

  .flow-result { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: end; margin-top: 1rem; border-block: 1px solid var(--color-line); padding-block: .8rem; }
  .flow-result > div { display: grid; gap: .2rem; }
  .flow-result small { color: var(--color-muted); font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; }
  .flow-result code { background: transparent; padding: 0; color: var(--color-ink-soft); }
  .flow-result strong { color: var(--color-accent-ink); font-size: 2rem; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
  .flow-link { display: inline-block; margin-top: 1rem; color: var(--color-accent-ink); font-weight: 700; text-decoration: none; }

  @media (max-width: 620px) {
    .flow-fields { grid-template-columns: 1fr; }
    .flow-result { grid-template-columns: 1fr; }
  }
</style>
