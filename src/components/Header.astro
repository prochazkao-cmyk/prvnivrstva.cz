---
import BrandMark from './BrandMark.astro';
import { site } from '../lib/site';

interface Props {
  tone?: 'overlay' | 'solid';
}

const { tone = 'solid' } = Astro.props;
const pathname = Astro.url.pathname;
const links = [
  { href: '/recenze/', label: 'Testy tiskáren' },
  { href: '/materialy/', label: 'Materiály' },
  { href: '/rady-a-tipy/z-offset/', label: 'Kalibrace' },
  { href: '/clanky/prusa-vs-bambu-lab-srovnani/', label: 'Srovnání' },
  { href: '/rady-a-tipy/', label: 'Tipy a návody' },
];

function isCurrent(href: string): boolean {
  if (href.includes('#')) return false;
  const path = pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;
  const target = href.length > 1 && href.endsWith('/') ? href.slice(0, -1) : href;
  if (target === '/') return path === '/';
  return path === target || path.startsWith(`${target}/`);
}
---

<a class="skip-link" href="#obsah">Přeskočit na obsah</a>
<header class:list={['site-header', { 'is-light': tone === 'solid' }]} data-header={tone}>
  <div class="page header-bar">
    <a href="/" class="brand">
      <BrandMark />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Hlavní">
      {links.map((link) => (
        <a class="nav-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="header-search" href="/problemy/" aria-label="Hledat řešení a problémy">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      </a>
      <div class="theme-switch theme-switch-persistent" role="group" aria-label="Vizuální preference Prusa nebo Bambu">
        <button class="theme-choice" type="button" data-theme-choice="bambu" aria-pressed="false">
          <span class="theme-dot theme-dot-bambu" aria-hidden="true"></span>
          Bambu
        </button>
        <button class="theme-choice" type="button" data-theme-choice="prusa" aria-pressed="true">
          <span class="theme-dot theme-dot-prusa" aria-hidden="true"></span>
          Průša
        </button>
      </div>
      <a class="nav-cta nav-cta-desktop" href="/#temata">Pro lepší 3D tisk <span aria-hidden="true">→</span></a>

      <div class="nav-mobile">
        <button class="nav-mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-mobile-menu-toggle>
          <span class="menu-icon" aria-hidden="true"></span>
          <span data-menu-label>Menu</span>
        </button>

        <nav id="mobile-menu" class="nav-mobile-panel" aria-label="Hlavní, mobilní" data-mobile-menu hidden>
          {links.map((link) => (
            <a class="nav-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
          ))}
          <a class="nav-link" href="/problemy/">Problémy</a>
          <a class="nav-link" href="/nastroje/">Nástroje</a>
          <a class="nav-link" href="/clanky/">Články</a>
          <a class="nav-link" href="/o-nas/">O nás</a>
          <a class="nav-cta" href="/#temata">Pro lepší 3D tisk</a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const headers = document.querySelectorAll<HTMLElement>('[data-header]');
  const hero = document.querySelector('.hero, .cover, .ref-hero');
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
  const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const mobileLabel = document.querySelector<HTMLElement>('[data-menu-label]');

  const updateHeader = () => {
    const scrolled = window.scrollY > 8;
    for (const header of headers) {
      header.classList.toggle('is-scrolled', scrolled);
      if (header.dataset.header !== 'overlay') continue;
      if (!hero) {
        header.classList.add('is-light');
        continue;
      }
      const headerBottom = header.getBoundingClientRect().bottom;
      const heroBottom = hero.getBoundingClientRect().bottom;
      header.classList.toggle('is-light', heroBottom <= headerBottom + 1);
    }
  };

  const closeMobileMenu = () => {
    if (!mobileToggle || !mobileMenu) return;
    mobileToggle.setAttribute('aria-expanded', 'false');
    mobileMenu.hidden = true;
    mobileLabel && (mobileLabel.textContent = 'Menu');
    document.documentElement.classList.remove('mobile-menu-open');
  };

  const openMobileMenu = () => {
    if (!mobileToggle || !mobileMenu) return;
    mobileToggle.setAttribute('aria-expanded', 'true');
    mobileMenu.hidden = false;
    mobileLabel && (mobileLabel.textContent = 'Zavřít');
    document.documentElement.classList.add('mobile-menu-open');
  };

  mobileToggle?.addEventListener('click', () => {
    const expanded = mobileToggle.getAttribute('aria-expanded') === 'true';
    expanded ? closeMobileMenu() : openMobileMenu();
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMobileMenu));
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMobileMenu();
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1240) closeMobileMenu();
    updateHeader();
  });

  const applyTheme = (theme: 'prusa' | 'bambu', persist = true) => {
    document.documentElement.dataset.brandTheme = theme;
    for (const button of themeButtons) {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme));
    }
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (meta) meta.content = theme === 'bambu' ? '#edf2ee' : '#f4eee4';
    if (persist) {
      try { localStorage.setItem('pv-theme', theme); } catch {}
      window.dispatchEvent(new CustomEvent('pv:theme-selected', { detail: { theme } }));
    }
  };

  const initialTheme = document.documentElement.dataset.brandTheme === 'bambu' ? 'bambu' : 'prusa';
  applyTheme(initialTheme, false);

  for (const button of themeButtons) {
    button.addEventListener('click', () => {
      const theme = button.dataset.themeChoice === 'bambu' ? 'bambu' : 'prusa';
      applyTheme(theme);
    });
  }

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
