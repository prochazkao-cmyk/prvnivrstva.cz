---
import BrandMark from './BrandMark.astro';
import { categoryOrder, categories } from '../lib/categories';
import { site } from '../lib/site';

interface Props {
  tone?: 'overlay' | 'solid';
}

const { tone = 'solid' } = Astro.props;
const pathname = Astro.url.pathname;
const links = [
  ...categoryOrder.map((id) => ({ href: categories[id].href, label: categories[id].label })),
  { href: '/o-nas/', label: 'O nás' },
];

function isCurrent(href: string): boolean {
  const path = pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;
  const target = href.length > 1 && href.endsWith('/') ? href.slice(0, -1) : href;
  if (target === '/') return path === '/';
  return path === target || path.startsWith(`${target}/`);
}
---

<a class="skip-link" href="#obsah">Přeskočit na obsah</a>
<header class:list={['site-header', { 'is-light': tone === 'solid' }]} data-header={tone}>
  <div class="page header-bar">
    <a href="/" class="brand">
      <BrandMark />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Hlavní">
      {
        links.map((link) => (
          <a class="nav-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="nav-cta" href="/#zebricek">Žebříček</a>
    </nav>

    <details class="nav-mobile">
      <summary>
        <span class="menu-icon" aria-hidden="true"></span>
        <span class="label-closed">Menu</span>
        <span class="label-open">Zavřít</span>
      </summary>
      <nav aria-label="Hlavní, mobilní">
        {
          links.map((link) => (
            <a class="nav-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
        <a class="nav-cta" href="/#zebricek">Otevřít žebříček</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const headers = document.querySelectorAll<HTMLElement>('[data-header]');
  const hero = document.querySelector('.hero');

  const update = () => {
    const scrolled = window.scrollY > 8;
    for (const header of headers) {
      header.classList.toggle('is-scrolled', scrolled);
      if (header.dataset.header !== 'overlay') continue;
      if (!hero) {
        header.classList.add('is-light');
        continue;
      }
      const headerBottom = header.getBoundingClientRect().bottom;
      const heroBottom = hero.getBoundingClientRect().bottom;
      header.classList.toggle('is-light', heroBottom <= headerBottom + 1);
    }
  };

  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
</script>
