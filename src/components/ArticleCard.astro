---
import type { Article } from '../lib/articles';
import { categories } from '../lib/categories';
import { formatDate, formatReading, formatScore, isoDate } from '../lib/format';

interface Props {
  article: Article;
  heading?: 'h1' | 'h2' | 'h3';
  variant?: 'lead' | 'side' | 'row';
  showCategory?: boolean;
  titleId?: string;
}

const {
  article,
  heading = 'h2',
  variant = 'row',
  showCategory = true,
  titleId,
} = Astro.props;

const Tag = heading;
const category = categories[article.category];
---

<article class:list={[`story story-${variant}`]}>
  {
    showCategory && (
      <p class="kicker">
        <a href={category.href}>{category.label}</a>
      </p>
    )
  }
  <Tag class="story-title" id={titleId}>
    <a href={article.href}>{article.title}</a>
  </Tag>
  {variant !== 'side' && <p class="story-dek">{article.description}</p>}
  <p class="meta">
    <time datetime={isoDate(article.publishedAt)}>{formatDate(article.publishedAt)}</time>
    <span aria-hidden="true">·</span>
    <span>{formatReading(article.readingMinutes)}</span>
    {
      article.score !== undefined && (
        <>
          <span aria-hidden="true">·</span>
          <span>
            <span class="sr-only">Hodnocení {formatScore(article.score)}. </span>
            <span aria-hidden="true">{formatScore(article.score)}</span>
          </span>
        </>
      )
    }
  </p>
</article>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
