---
interface Props {
  class?: string;
}

const { class: className = 'brand-mark' } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true">
  <rect width="64" height="64" rx="4" fill="#17150f"></rect>
  <rect x="10" y="14" width="44" height="4" fill="#f4f0e6"></rect>
  <rect x="10" y="26" width="32" height="4" fill="#f4f0e6"></rect>
  <rect x="10" y="40" width="44" height="10" fill="var(--color-accent, #ff6b35)"></rect>
</svg>
