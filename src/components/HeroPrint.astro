---
/**
 * Decorative macro of a nozzle laying down a first layer.
 * Motion is transform + stroke-dashoffset only, and it stops when the
 * visitor asks for reduced motion.
 */
---

<div class="hero-scene">
  <svg class="hero-bed" viewBox="0 0 1200 240" aria-hidden="true">
    <ellipse cx="600" cy="214" rx="430" ry="14" fill="rgba(0,0,0,0.45)"></ellipse>
    <rect x="48" y="58" width="1104" height="132" rx="18" fill="#121216"></rect>
    <rect x="72" y="40" width="1056" height="28" rx="5" fill="#1b1b20"></rect>
    <rect x="72" y="40" width="1056" height="3" fill="#3a3a42"></rect>
    <g stroke="rgba(255,255,255,0.045)" stroke-width="1">
      <line x1="96" x2="1104" y1="78" y2="78"></line>
      <line x1="96" x2="1104" y1="96" y2="96"></line>
      <line x1="96" x2="1104" y1="114" y2="114"></line>
      <line x1="96" x2="1104" y1="132" y2="132"></line>
      <line x1="96" x2="1104" y1="150" y2="150"></line>
    </g>
    <path d="M150 62 H1050" fill="none" stroke="rgba(255,77,0,0.22)" stroke-width="4" stroke-linecap="round"></path>
    <path d="M170 72 H1030" fill="none" stroke="rgba(255,77,0,0.1)" stroke-width="3" stroke-linecap="round"></path>
    <path
      class="bead"
      pathLength="1"
      d="M140 30 H1060"
      fill="none"
      stroke="#ff4d00"
      stroke-width="8"
      stroke-linecap="round"></path>
    <path
      class="bead-core"
      pathLength="1"
      d="M140 30 H1060"
      fill="none"
      stroke="#ffd2b8"
      stroke-width="2.5"
      stroke-linecap="round"></path>
  </svg>
  <div class="nozzle-mover" aria-hidden="true">
    <svg class="nozzle" viewBox="0 0 80 164">
      <defs>
        <linearGradient id="pv-brass" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f3d7b0"></stop>
          <stop offset="1" stop-color="#b58145"></stop>
        </linearGradient>
      </defs>
      <rect x="34" y="0" width="12" height="26" rx="3" fill="#2c2c32"></rect>
      <rect x="37.5" y="0" width="5" height="36" rx="2" fill="#ff4d00"></rect>
      <rect x="27" y="26" width="26" height="50" rx="3" fill="#3c3c44"></rect>
      <rect x="16" y="32" width="48" height="5" rx="1" fill="#5a5a64"></rect>
      <rect x="16" y="42" width="48" height="5" rx="1" fill="#4a4a52"></rect>
      <rect x="16" y="52" width="48" height="5" rx="1" fill="#5a5a64"></rect>
      <rect x="16" y="62" width="48" height="5" rx="1" fill="#4a4a52"></rect>
      <rect x="35" y="76" width="10" height="16" fill="#9a9aa2"></rect>
      <rect x="37.5" y="76" width="5" height="16" fill="#ff4d00" opacity="0.9"></rect>
      <rect x="15" y="90" width="50" height="36" rx="6" fill="#141416" stroke="#32323a"></rect>
      <rect x="22" y="104" width="20" height="6" rx="2" fill="#2a2a30"></rect>
      <circle class="led" cx="54" cy="107" r="3.1" fill="#5cffd6"></circle>
      <path d="M27 126h26l-6 28h-14l-6-28z" fill="url(#pv-brass)"></path>
      <path d="M36 128h8l-1.6 22h-4.8L36 128z" fill="#ff4d00"></path>
      <rect x="36.5" y="152" width="7" height="12" rx="3.5" fill="#ff7a3c"></rect>
    </svg>
  </div>
</div>

<style>
  .hero-scene {
    position: relative;
    width: min(100%, 1100px);
    margin-inline: auto;
    container-type: inline-size;
  }

  .hero-bed {
    display: block;
    width: 100%;
    height: auto;
  }

  .bead,
  .bead-core {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 6.4s linear infinite;
  }

  .bead {
    filter: drop-shadow(0 0 7px rgba(255, 77, 0, 0.55));
  }

  .nozzle-mover {
    position: absolute;
    z-index: 1;
    top: 12.5%;
    left: 0;
    width: clamp(68px, 10cqw, 118px);
    pointer-events: none;
    animation: extrude 6.4s linear infinite;
  }

  .nozzle {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.35));
  }

  .nozzle-mover::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 46%;
    height: 14px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, rgba(255, 77, 0, 0.75), transparent 70%);
  }

  .led {
    transform-origin: center;
    transform-box: fill-box;
  }

  @keyframes draw {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    74% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    88% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    96% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    100% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
  }

  @keyframes extrude {
    0% {
      transform: translate3d(11.667cqw, -100%, 0) translateX(-50%);
      opacity: 1;
    }
    74%,
    88% {
      transform: translate3d(88.333cqw, -100%, 0) translateX(-50%);
      opacity: 1;
    }
    96% {
      transform: translate3d(88.333cqw, -100%, 0) translateX(-50%);
      opacity: 0;
    }
    97% {
      transform: translate3d(11.667cqw, -100%, 0) translateX(-50%);
      opacity: 0;
    }
    100% {
      transform: translate3d(11.667cqw, -100%, 0) translateX(-50%);
      opacity: 1;
    }
  }

  @keyframes led-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .led {
      animation: led-pulse 2.6s ease-in-out infinite;
    }

    @supports (animation-timeline: scroll()) {
      .hero-scene {
        animation: scene-drift linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 45%;
      }
    }
  }

  @keyframes scene-drift {
    to {
      transform: translateY(-28px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bead,
    .bead-core,
    .nozzle-mover,
    .led,
    .hero-scene {
      animation: none;
    }

    .bead,
    .bead-core {
      stroke-dashoffset: 0;
      opacity: 1;
    }

    .nozzle-mover {
      transform: translate3d(58cqw, -100%, 0) translateX(-50%);
      opacity: 1;
    }
  }
</style>
