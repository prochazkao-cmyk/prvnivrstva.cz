---
import BaseLayout from './BaseLayout.astro';
import { categories, type CategoryId } from '../lib/categories';
import type { Article } from '../lib/articles';
import { formatDate, formatReading, formatScore, formatScoreBadge, isoDate } from '../lib/format';
import { site } from '../lib/site';

interface Props {
  article: Article;
  related: Article[];
}

const { article, related } = Astro.props;
const category = categories[article.category as CategoryId];
const canonical = new URL(article.href, Astro.site).href;
const modified = article.updatedAt ?? article.publishedAt;

const evidenceLabels: Record<Article['evidence'], string> = {
  redakce: 'Redakční průvodce',
  vyrobce: 'Technické údaje výrobce',
  'vlastni-mereni': 'Vlastní měření První Vrstvy',
  kombinace: 'Kombinace měření, specifikací a redakční zkušenosti',
  demo: 'Demonstrační / neověřená data',
};

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': article.score !== undefined ? 'Review' : 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.publishedAt.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: 'cs',
  author: { '@type': 'Organization', name: article.author },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo: { '@type': 'ImageObject', url: new URL('/logo.svg', site.url).href },
  },
  mainEntityOfPage: canonical,
};

if (article.score !== undefined) {
  jsonLd.itemReviewed = {
    '@type': 'Product',
    name: article.product ?? article.title,
  };
  jsonLd.reviewRating = {
    '@type': 'Rating',
    ratingValue: article.score,
    bestRating: 10,
    worstRating: 1,
  };
}
---

<BaseLayout
  title={article.title}
  description={article.description}
  ogType="article"
  publishedAt={article.publishedAt}
  updatedAt={modified}
  jsonLd={jsonLd}
>
  <main id="obsah" class="page section-page">
    <article>
      <nav class="crumbs" aria-label="Drobečková navigace">
        <a href="/">Úvod</a>
        <span aria-hidden="true">/</span>
        <a href={category.href}>{category.label}</a>
      </nav>

      <p class="kicker">
        <a href={category.href}>{category.label}</a>
        {article.product && <span class="kicker-note"> · {article.product}</span>}
        {
          !article.product && article.technologies.length > 0 && (
            <span class="kicker-note"> · {article.technologies.join(', ')}</span>
          )
        }
      </p>
      <h1 class="page-title">{article.title}</h1>
      <p class="lede">{article.description}</p>
      <p class="meta">
        <time datetime={isoDate(article.publishedAt)}>{formatDate(article.publishedAt)}</time>
        {
          article.updatedAt && (
            <>
              <span aria-hidden="true">·</span>
              <span>Aktualizováno {formatDate(article.updatedAt)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{formatReading(article.readingMinutes)}</span>
        {
          article.level && (
            <>
              <span aria-hidden="true">·</span>
              <span>Úroveň: {article.level}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{article.author}</span>
      </p>

      <aside class="trust-strip" aria-label="Původ a stav informací">
        <div>
          <span class="trust-label">Původ informací</span>
          <strong>{evidenceLabels[article.evidence]}</strong>
        </div>
        {article.sourceNote && (
          <div>
            <span class="trust-label">Podklad</span>
            <span>{article.sourceNote}</span>
          </div>
        )}
        {article.reviewedAt && (
          <div>
            <span class="trust-label">Naposledy zkontrolováno</span>
            <span>{formatDate(article.reviewedAt)}</span>
          </div>
        )}
        {article.disclosure && (
          <div>
            <span class="trust-label">Vztah k produktu</span>
            <span>{article.disclosure}</span>
          </div>
        )}
      </aside>

      {article.note && <p class="note-banner">{article.note}</p>}

      {
        (article.verdict || article.score !== undefined) && (
          <div class="verdict">
            {article.score !== undefined && (
              <p class="score-orb" style="margin: 0">
                {formatScoreBadge(article.score)}
                <span class="sr-only">Hodnocení {formatScore(article.score)}</span>
              </p>
            )}
            {article.verdict && <p class="lede" style="margin: 0">{article.verdict}</p>}
          </div>
        )
      }

      <div class="article-body" style="margin-top: 2rem; max-width: 68ch">
        <slot />
      </div>

      {
        article.tags.length > 0 && (
          <ul class="tag-list" aria-label="Štítky">
            {article.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </article>

    {
      related.length > 0 && (
        <section style="margin-top: 4rem" aria-labelledby="souvisejici">
          <h2 id="souvisejici" class="subhead" style="margin-top: 0">Z téže rubriky</h2>
          <ul class="related-list">
            {related.map((item) => (
              <li>
                <a href={item.href}>
                  {item.title}
                  <p>{item.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .kicker-note {
    color: var(--color-muted);
    font-weight: 520;
    letter-spacing: 0;
    text-transform: none;
  }

  .trust-strip {
    display: grid;
    gap: .9rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 1rem 0;
  }

  .trust-strip > div {
    display: grid;
    gap: .2rem;
  }

  .trust-label {
    color: var(--color-muted);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .trust-strip strong,
  .trust-strip span:not(.trust-label) {
    font-size: .88rem;
    line-height: 1.45;
  }
</style>
