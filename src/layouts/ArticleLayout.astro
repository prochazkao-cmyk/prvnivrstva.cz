---
import BaseLayout from './BaseLayout.astro';
import { categories, type CategoryId } from '../lib/categories';
import type { Article } from '../lib/articles';
import { formatDate, formatReading, formatScore, isoDate } from '../lib/format';
import { site } from '../lib/site';

interface Props {
  article: Article;
  related: Article[];
}

const { article, related } = Astro.props;
const category = categories[article.category as CategoryId];
const canonical = new URL(article.href, Astro.site).href;
const modified = article.updatedAt ?? article.publishedAt;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': article.score !== undefined ? 'Review' : 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.publishedAt.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: 'cs',
  author: { '@type': 'Organization', name: article.author },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo: { '@type': 'ImageObject', url: new URL('/logo.svg', site.url).href },
  },
  mainEntityOfPage: canonical,
};

if (article.score !== undefined) {
  jsonLd.itemReviewed = {
    '@type': 'Product',
    name: article.product ?? article.title,
  };
  jsonLd.reviewRating = {
    '@type': 'Rating',
    ratingValue: article.score,
    bestRating: 10,
    worstRating: 1,
  };
}
---

<BaseLayout
  title={article.title}
  description={article.description}
  ogType="article"
  publishedAt={article.publishedAt}
  updatedAt={modified}
  jsonLd={jsonLd}
>
  <main id="obsah" class="mx-auto max-w-6xl px-5 py-10">
    <article>
      <nav class="crumbs" aria-label="Drobečková navigace">
        <a href="/">Úvod</a>
        <span aria-hidden="true">/</span>
        <a href={category.href}>{category.label}</a>
      </nav>

      <p class="kicker">
        <a href={category.href}>{category.label}</a>
        {article.product && <span class="text-muted normal-case tracking-normal"> · {article.product}</span>}
        {
          !article.product && article.technologies.length > 0 && (
            <span class="text-muted normal-case tracking-normal"> · {article.technologies.join(', ')}</span>
          )
        }
      </p>
      <h1 class="mt-3 max-w-[20ch] font-serif text-[clamp(2.2rem,5vw,3.6rem)] leading-[1.05] font-semibold tracking-tight">
        {article.title}
      </h1>
      <p class="mt-4 max-w-[62ch] text-xl leading-snug text-ink-soft">{article.description}</p>
      <p class="meta">
        <time datetime={isoDate(article.publishedAt)}>{formatDate(article.publishedAt)}</time>
        {
          article.updatedAt && (
            <>
              <span aria-hidden="true">·</span>
              <span>Aktualizováno {formatDate(article.updatedAt)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{formatReading(article.readingMinutes)}</span>
        {
          article.level && (
            <>
              <span aria-hidden="true">·</span>
              <span>Úroveň: {article.level}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{article.author}</span>
      </p>

      {article.note && <p class="note-banner">{article.note}</p>}

      {
        (article.verdict || article.score !== undefined) && (
          <div class="verdict">
            {article.score !== undefined && (
              <p class="m-0">
                <span class="score-num">{formatScore(article.score).replace(' / 10', '')}</span>
                <span class="score-denom"> / 10</span>
                <span class="mt-1 block text-sm text-muted">orientační známka</span>
                <span class="sr-only">Hodnocení {formatScore(article.score)}</span>
              </p>
            )}
            {article.verdict && <p class="m-0 text-lg leading-snug">{article.verdict}</p>}
          </div>
        )
      }

      <div class="article-body mt-8 max-w-[68ch]">
        <slot />
      </div>

      {
        article.tags.length > 0 && (
          <ul class="tag-list" aria-label="Štítky">
            {article.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </article>

    {
      related.length > 0 && (
        <section class="mt-14 border-t border-ink pt-8" aria-labelledby="souvisejici">
          <h2 id="souvisejici" class="font-serif text-3xl font-semibold tracking-tight">
            Z téže rubriky
          </h2>
          <ul class="mt-4 divide-y divide-line border-b border-line">
            {related.map((item) => (
              <li class="py-4">
                <a class="font-serif text-2xl font-semibold tracking-tight text-ink no-underline hover:text-copper-ink" href={item.href}>
                  {item.title}
                </a>
                <p class="mt-1 max-w-[62ch] text-ink-soft">{item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
