---
import BaseLayout from './BaseLayout.astro';
import { categories, type CategoryId } from '../lib/categories';
import type { Article } from '../lib/articles';
import { formatDate, formatReading, formatScore, formatScoreBadge, isoDate } from '../lib/format';
import { site } from '../lib/site';

interface Props {
  article: Article;
  related: Article[];
}

const { article, related } = Astro.props;
const category = categories[article.category as CategoryId];
const canonical = new URL(article.href, Astro.site).href;
const modified = article.updatedAt ?? article.publishedAt;

const evidenceLabels: Record<Article['evidence'], string> = {
  redakce: 'Redakční průvodce',
  vyrobce: 'Technické údaje výrobce',
  'vlastni-mereni': 'Vlastní měření První Vrstvy',
  kombinace: 'Kombinace měření, specifikací a redakční zkušenosti',
  demo: 'Demonstrační / neověřená data',
};

const lowerTags = article.tags.map((tag) => tag.toLocaleLowerCase('cs'));
const materialIntent = lowerTags.some((tag) =>
  ['pla', 'petg', 'asa', 'abs', 'tpu', 'nylon', 'filament', 'sušení', 'vlhkost'].some((needle) => tag.includes(needle)),
);

const hasReviewProtocol =
  article.category === 'recenze' &&
  Boolean(article.testDuration) &&
  article.printHours !== undefined &&
  Array.isArray(article.failures) &&
  ['vlastni-mereni', 'kombinace'].includes(article.evidence);
const publishScore = hasReviewProtocol && article.score !== undefined;

const nextAction =
  article.category === 'recenze' || article.category === 'stroje'
    ? { href: '/clanky/prusa-vs-bambu-lab-srovnani/', eyebrow: 'Rozhodujete se?', title: 'Porovnat stroje v kontextu', copy: 'Verdikt jedné tiskárny dává smysl až vedle alternativ, jejich slabin a způsobu použití.' }
    : materialIntent
      ? { href: '/materialy/', eyebrow: 'Materiál', title: 'Otevřít materiálovou referenci', copy: 'Porovnejte tiskové rozsahy, sušení, komoru a hlavní kompromisy se zdroji.' }
      : article.category === 'rady-a-tipy'
        ? { href: '/problemy/', eyebrow: 'Další symptom', title: 'Vrátit se do tiskové poradny', copy: 'Vyberte další problém podle toho, co na výtisku skutečně vidíte.' }
        : { href: '/nastroje/', eyebrow: 'Další krok', title: 'Otevřít nástroje pro dílnu', copy: 'Spočítejte cenu výtisku, flow nebo pokračujte do praktické reference.' };

const authorIsPerson = article.author !== 'Redakce První vrstvy' && article.author !== 'Redakce První vrstvy';
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': publishScore ? 'Review' : 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.publishedAt.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: 'cs',
  author: authorIsPerson
    ? { '@type': 'Person', name: article.author }
    : { '@type': 'Organization', name: article.author },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo: { '@type': 'ImageObject', url: new URL('/logo.svg', site.url).href },
  },
  mainEntityOfPage: canonical,
};

if (publishScore) {
  jsonLd.itemReviewed = {
    '@type': 'Product',
    name: article.product ?? article.title,
  };
  jsonLd.reviewRating = {
    '@type': 'Rating',
    ratingValue: article.score,
    bestRating: 10,
    worstRating: 1,
  };
}
---

<BaseLayout
  title={article.title}
  description={article.description}
  ogType="article"
  publishedAt={article.publishedAt}
  updatedAt={modified}
  jsonLd={jsonLd}
>
  <main id="obsah" class="page section-page">
    <article>
      <nav class="crumbs" aria-label="Drobečková navigace">
        <a href="/">Úvod</a>
        <span aria-hidden="true">/</span>
        <a href={category.href}>{category.label}</a>
      </nav>

      <p class="kicker">
        <a href={category.href}>{category.label}</a>
        {article.product && <span class="kicker-note"> · {article.product}</span>}
        {
          !article.product && article.technologies.length > 0 && (
            <span class="kicker-note"> · {article.technologies.join(', ')}</span>
          )
        }
      </p>
      <h1 class="page-title">{article.title}</h1>
      <p class="lede">{article.description}</p>
      <p class="meta">
        <time datetime={isoDate(article.publishedAt)}>{formatDate(article.publishedAt)}</time>
        {
          article.updatedAt && (
            <>
              <span aria-hidden="true">·</span>
              <span>Aktualizováno {formatDate(article.updatedAt)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{formatReading(article.readingMinutes)}</span>
        {
          article.level && (
            <>
              <span aria-hidden="true">·</span>
              <span>Úroveň: {article.level}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        {
          authorIsPerson && article.author.toLocaleLowerCase('cs').includes('ondřej')
            ? <a href="/autor/ondrej-prochazka/">{article.author}</a>
            : <span>{article.author}</span>
        }
      </p>

      <aside class="trust-strip" aria-label="Původ a stav informací">
        <div>
          <span class="trust-label">Původ informací</span>
          <strong>{evidenceLabels[article.evidence]}</strong>
        </div>
        {article.sourceNote && (
          <div>
            <span class="trust-label">Podklad</span>
            <span>{article.sourceNote}</span>
          </div>
        )}
        {article.reviewedAt && (
          <div>
            <span class="trust-label">Naposledy zkontrolováno</span>
            <span>{formatDate(article.reviewedAt)}</span>
          </div>
        )}
        {article.disclosure && (
          <div>
            <span class="trust-label">Vztah k produktu</span>
            <span>{article.disclosure}</span>
          </div>
        )}
        {article.affiliate && (
          <div>
            <span class="trust-label">Affiliate</span>
            <span>Článek může obsahovat označené provizní odkazy. Nemění verdikt ani pořadí.</span>
          </div>
        )}
      </aside>

      {
        article.category === 'recenze' && hasReviewProtocol && (
          <aside class="review-protocol" aria-label="Testovací protokol">
            <p class="trust-label">Testovací protokol</p>
            <div class="review-protocol-grid">
              <div><span>Délka testu</span><strong>{article.testDuration}</strong></div>
              <div><span>Čas tisku</span><strong>{article.printHours} h</strong></div>
              <div>
                <span>Závady během testu</span>
                <strong>{article.failures && article.failures.length > 0 ? article.failures.join(' · ') : 'Bez zaznamenané závady'}</strong>
              </div>
            </div>
            <a href="/metodika/">Jak testujeme →</a>
          </aside>
        )
      }

      {article.note && <p class="note-banner">{article.note}</p>}

      {
        (article.verdict || publishScore) && (
          <div class="verdict">
            {publishScore && (
              <p class="score-orb" style="margin: 0">
                {formatScoreBadge(article.score!)}
                <span class="sr-only">Hodnocení {formatScore(article.score!)}</span>
              </p>
            )}
            {article.verdict && <p class="lede" style="margin: 0">{article.verdict}</p>}
          </div>
        )
      }

      <div class="article-body" style="margin-top: 2rem; max-width: 68ch">
        <slot />
      </div>

      {
        article.tags.length > 0 && (
          <ul class="tag-list" aria-label="Štítky">
            {article.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </article>

    <aside class="article-next" aria-label="Doporučený další krok">
      <div>
        <p>{nextAction.eyebrow}</p>
        <h2>{nextAction.title}</h2>
        <span>{nextAction.copy}</span>
      </div>
      <a href={nextAction.href}>Pokračovat <span aria-hidden="true">→</span></a>
    </aside>

    {
      related.length > 0 && (
        <section style="margin-top: 4rem" aria-labelledby="souvisejici">
          <p class="kicker">Podle stejného tématu</p>
          <h2 id="souvisejici" class="subhead related-head">Pokračujte tam, kde to dává smysl.</h2>
          <ul class="related-list">
            {related.map((item) => (
              <li>
                <a href={item.href}>
                  {item.title}
                  <p>{item.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .kicker-note {
    color: var(--color-muted);
    font-weight: 520;
    letter-spacing: 0;
    text-transform: none;
  }

  .meta a { color: inherit; text-underline-offset: 3px; }

  .trust-strip {
    display: grid;
    gap: .9rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 1rem 0;
  }

  .trust-strip > div {
    display: grid;
    gap: .2rem;
  }

  .trust-label {
    color: var(--color-muted);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .trust-strip strong,
  .trust-strip span:not(.trust-label) {
    font-size: .88rem;
    line-height: 1.45;
  }

  .review-protocol {
    margin-top: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
    padding: 1rem 1.15rem;
  }

  .review-protocol > p { margin: 0 0 .7rem; }
  .review-protocol-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
  .review-protocol-grid > div { display: grid; gap: .18rem; }
  .review-protocol-grid span { color: var(--color-muted); font-size: .75rem; }
  .review-protocol-grid strong { font-size: .9rem; line-height: 1.35; }
  .review-protocol > a { display: inline-block; margin-top: .8rem; color: var(--color-accent-ink); font-size: .84rem; font-weight: 700; }

  .article-next {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 3rem;
    border-radius: var(--radius-card);
    background: var(--color-night);
    padding: clamp(1.2rem, 3vw, 1.7rem);
    color: #f5f5f7;
  }

  .article-next > div { display: grid; gap: .25rem; }
  .article-next p { margin: 0; color: var(--color-accent); font-size: .7rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .article-next h2 { margin: 0; font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -.04em; }
  .article-next div > span { max-width: 48rem; color: rgba(245,245,247,.68); font-size: .92rem; }
  .article-next > a { display: inline-flex; flex: none; align-items: center; gap: .55rem; border-radius: 999px; background: var(--color-accent); padding: .7rem 1rem; color: #1a0d08; font-weight: 720; text-decoration: none; }
  .related-head { margin-top: .35rem !important; }

  @media (max-width: 680px) {
    .review-protocol-grid { grid-template-columns: 1fr; }
    .article-next { align-items: flex-start; flex-direction: column; }
  }
</style>
